            canvas:SetStretchTexture(true)
            canvas:Show(false)
            self.level_canvases[m.id] = canvas
        end
    end

    -- Detail Regional Level Map (Legacy Fallback)
    self.map_canvas         = xml:InitStatic("map_frame:map_canvas", self.map_frame)
