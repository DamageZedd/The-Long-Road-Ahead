-- Safe sound object loader
local function safe_sound(snd_path)
    local snd = nil
    pcall(function()
        snd = sound_object(snd_path)
    end)
    return snd
end

-- Parse level bound_rect string into coordinate numbers
local function parse_bound_rect(raw)
    if type(raw) ~= "string" then return nil end
    local x1, z1, x2, z2 = string.match(raw, "^%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)")
    x1, z1, x2, z2 = tonumber(x1), tonumber(z1), tonumber(x2), tonumber(z2)
    if not (x1 and z1 and x2 and z2) then return nil end
    if x2 <= x1 or z2 <= z1 then return nil end
    return { x1 = x1, z1 = z1, x2 = x2, z2 = z2 }
end

-- Read level bounds from game configs or fallback table
local function get_level_bounds(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local bounds = nil

    -- 1. Try reading bound_rect from game_maps_single.ltx
    pcall(function()
        local ini = ini_file("game_maps_single.ltx")
        if ini and ini:section_exist(level_name) then
            local raw = ini:r_string_ex(level_name, "bound_rect")
            if raw then bounds = parse_bound_rect(raw) end
        end
    end)

    -- 2. Try reading from level.ltx
    if not bounds then
        pcall(function()
            local fs = getFS()
            if fs and fs.r_open then
                local reader = fs:r_open("$game_levels$", level_name .. "/level.ltx")
                if reader then
                    local ini = ini_file(reader, "$game_levels$")
                    if ini and ini:section_exist("level_map") then
                        local raw = ini:r_string_ex("level_map", "bound_rect")
                        if raw then bounds = parse_bound_rect(raw) end
                    end
                end
            end
        end)
    end

    -- 3. Pre-cached fallback table
    if not bounds then
        bounds = FALLBACK_LEVEL_BOUNDS[level_name]
    end

    return bounds
end

-- Read global Zone map canvas bounds
local function get_global_bounds()
    local canvas = nil
    pcall(function()
        local ini = ini_file("game_maps_single.ltx")
        if ini and ini:section_exist("global_map") then
            local raw = ini:r_string_ex("global_map", "bound_rect")
            if raw then canvas = parse_bound_rect(raw) end
        end
    end)
    return canvas or { x1 = 0, z1 = 0, x2 = 1000, z2 = 2000 }
end

-- Read level placement rectangle on global Zone map
local function get_level_global_rect(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local rect = nil
    pcall(function()
        local ini = ini_file("game_maps_single.ltx")
        if ini and ini:section_exist(level_name) then
            local raw = ini:r_string_ex(level_name, "global_rect")
            if raw then rect = parse_bound_rect(raw) end
        end
    end)
    return rect
end

-- ===================================================================
-- UI WINDOW CLASS
-- ===================================================================
class "UIRoadAheadTravelMap" (CUIScriptWnd)

function UIRoadAheadTravelMap:__init() super()
    self.travel_paused      = false
    self.encounter_active   = false
    self.last_log_step      = 0
    self.log_history        = {}
    self.waypoints          = {}
    self.seg_lengths        = {}
    self.cum_dist           = { 0 }
    self.total_path_len     = 1

    -- Sound feedback
    self.snd_alarm  = safe_sound("detectors/contact_1")
    self.snd_evade  = safe_sound("interface/mp_reward")
    self.snd_click  = safe_sound("interface/inv_open")

    self:InitControls()
    self:InitCallbacks()
end

function UIRoadAheadTravelMap:__finalize()
    GUI = nil
end

function UIRoadAheadTravelMap:InitControls()
    -- Exact standard 1024x768 virtual coordinates
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_tlra_travel_map.xml")

    -- Solid pitch-black backdrop (Covers ultrawide & multi-monitor setups)
    self.bg = xml:InitStatic("background", self)
    pcall(function()
        self.bg:SetWndRect(Frect():set(-1200, -600, 3424, 1968))
    end)

        -- 1. Fullscreen Map Viewport Frame (1024x768)
    self.map_frame          = xml:InitStatic("map_frame", self)
    self.map_frame_bg       = xml:InitStatic("map_frame:map_frame_bg", self.map_frame)

    -- Layer 1: Continuous Zone Global Map
    self.bg_map_canvas      = xml:InitStatic("map_frame:bg_map_canvas", self.map_frame)
    self.bg_map_canvas:SetStretchTexture(true)

    -- Layer 2: Detail Regional Level Map
    self.map_canvas         = xml:InitStatic("map_frame:map_canvas", self.map_frame)
    self.map_canvas:SetStretchTexture(true)

    -- Departure & Destination Map Spots
    self.start_marker       = xml:InitStatic("map_frame:start_marker", self.map_frame)
    self.dest_marker        = xml:InitStatic("map_frame:dest_marker", self.map_frame)

    -- Dashed Yellow Road Breadcrumbs (1..12)
    self.trail_dots = {}
    for i = 1, 12 do
        self.trail_dots[i] = xml:InitStatic("map_frame:trail_dot_" .. i, self.map_frame)
    end

    -- Stalker Traveler Pawn: Anchored Dead-Center at (497, 364)
    self.pawn_marker        = xml:InitStatic("map_frame:pawn_marker", self.map_frame)

    -- 2. Top-Left: Military Field Dossier / Clipboard Tab
    self.dossier_tab        = xml:InitStatic("dossier_tab", self)
    self.txt_title          = xml:InitTextWnd("dossier_tab:txt_title", self.dossier_tab)
    self.txt_route          = xml:InitTextWnd("dossier_tab:txt_route", self.dossier_tab)
    self.txt_pace           = xml:InitTextWnd("dossier_tab:txt_pace", self.dossier_tab)

    -- 3. Top-Center: Floating Tactical HUD (Clock, Weather, Threat)
    self.top_center         = xml:InitStatic("top_center", self)
    self.txt_clock          = xml:InitTextWnd("top_center:txt_clock", self.top_center)
    self.txt_env            = xml:InitTextWnd("top_center:txt_weather", self.top_center)
    self.txt_threat_hud     = xml:InitTextWnd("top_center:txt_threat", self.top_center)

    -- 4. Top-Right: Trip Progress & Dual Gauges
    self.top_right          = xml:InitStatic("top_right", self)
    self.txt_progress       = xml:InitTextWnd("top_right:txt_progress", self.top_right)
    self.progress_border    = xml:InitStatic("top_right:progress_border", self.top_right)
    self.progress_bg        = xml:InitStatic("top_right:progress_bg", self.top_right)
    self.progress_fill      = xml:InitStatic("top_right:progress_fill", self.top_right)
    self.threat_fill        = xml:InitStatic("top_right:threat_fill", self.top_right)

    -- 5. Bottom-Left: Floating Survival Metabolism Telemetry
    self.vitals_panel       = xml:InitStatic("vitals_panel", self)
    self.txt_calories       = xml:InitTextWnd("vitals_panel:txt_calories", self.vitals_panel)
    self.txt_hydration      = xml:InitTextWnd("vitals_panel:txt_hydration", self.vitals_panel)
    self.txt_stamina        = xml:InitTextWnd("vitals_panel:txt_stamina", self.vitals_panel)
    self.txt_encumbrance    = xml:InitTextWnd("vitals_panel:txt_encumbrance", self.vitals_panel)
    self.txt_rad            = xml:InitTextWnd("vitals_panel:txt_rad", self.vitals_panel)
    self.txt_psy            = xml:InitTextWnd("vitals_panel:txt_psy", self.vitals_panel)
    self.psy_fill           = xml:InitStatic("vitals_panel:psy_fill", self.vitals_panel)

    -- 6. Bottom-Center: Authentic S.T.A.L.K.E.R. Field Journal & Log
    self.journal_card       = xml:InitStatic("journal_card", self)
    self.txt_logs = {}
    for i = 1, 5 do
        self.txt_logs[i] = xml:InitTextWnd("journal_card:txt_log_" .. i, self.journal_card)
    end

    -- 7. Bottom-Right: Heavy Rusted Industrial Metal Button
    self.btn_halt           = xml:Init3tButton("btn_halt", self)
    self:Register(self.btn_halt, "btn_halt")

    -- KCD Ambush / Threat Decision Modal Card
    self.encounter_modal        = xml:InitStatic("encounter_modal", self)
    self.modal_bg               = xml:InitStatic("encounter_modal:modal_bg", self.encounter_modal)
    self.modal_top_line         = xml:InitStatic("encounter_modal:modal_top_line", self.encounter_modal)
    self.modal_bot_line         = xml:InitStatic("encounter_modal:modal_bot_line", self.encounter_modal)
    self.modal_left_line        = xml:InitStatic("encounter_modal:modal_left_line", self.encounter_modal)
    self.modal_right_line       = xml:InitStatic("encounter_modal:modal_right_line", self.encounter_modal)
    self.txt_threat_title       = xml:InitTextWnd("encounter_modal:txt_threat_title", self.encounter_modal)
    self.txt_threat_desc        = xml:InitTextWnd("encounter_modal:txt_threat_desc", self.encounter_modal)
    self.txt_threat_range       = xml:InitTextWnd("encounter_modal:txt_threat_range", self.encounter_modal)
    self.txt_threat_stealth_info= xml:InitTextWnd("encounter_modal:txt_threat_stealth_info", self.encounter_modal)

    self.evasion_box            = xml:InitStatic("encounter_modal:evasion_box", self.encounter_modal)
    self.evasion_bg             = xml:InitStatic("encounter_modal:evasion_box:evasion_bg", self.evasion_box)
    self.evasion_top_line       = xml:InitStatic("encounter_modal:evasion_box:evasion_top_line", self.evasion_box)
    self.evasion_bot_line       = xml:InitStatic("encounter_modal:evasion_box:evasion_bot_line", self.evasion_box)
    self.txt_evasion_odds       = xml:InitTextWnd("encounter_modal:evasion_box:txt_evasion_odds", self.evasion_box)

    self.btn_attempt_evade      = xml:Init3tButton("encounter_modal:btn_attempt_evade", self.encounter_modal)
    self:Register(self.btn_attempt_evade, "btn_attempt_evade")

    self.btn_drop_and_fight     = xml:Init3tButton("encounter_modal:btn_drop_and_fight", self.encounter_modal)
    self:Register(self.btn_drop_and_fight, "btn_drop_and_fight")

    -- Initially hide encounter card
    self.encounter_modal:Show(false)
end

function UIRoadAheadTravelMap:InitCallbacks()
    self:AddCallback("btn_halt", ui_events.BUTTON_CLICKED, self.OnHaltClicked, self)
    self:AddCallback("btn_attempt_evade", ui_events.BUTTON_CLICKED, self.OnAttemptEvade, self)
    self:AddCallback("btn_drop_and_fight", ui_events.BUTTON_CLICKED, self.OnDropAndFight, self)
end

-- Setup and launch expedition display
function UIRoadAheadTravelMap:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist)
    self.start_pos      = start_pos or (db.actor and db.actor:position()) or vector():set(0, 0, 0)
    self.dest_pos       = dest_pos or self.start_pos
    self.level_name     = level_name or (level and level.name and level.name()) or "Zone"
    self.is_transition  = is_transition or false
    self.travel_dist    = travel_dist or math.max(1, self.start_pos:distance_to(self.dest_pos))
    self.travel_paused  = false
    self.encounter_active = false
    self.last_log_step  = 0
    self.log_history    = {}

    -- Load geographic map coordinates
    self.bounds         = get_level_bounds(self.level_name)
    self.global_canvas  = get_global_bounds()
    self.global_rect    = get_level_global_rect(self.level_name)

    -- Configure Detail Map Layer
    local tex_id = LEVEL_MAP_TEXTURES[self.level_name] or "tlra_map_global"
    if self.is_transition then
        tex_id = "tlra_map_global"
    end
    self.detail_tex_id = tex_id

    local tex_size = MAP_TEXTURE_SIZES[tex_id] or { w = 2048, h = 2048 }
    self.detail_tex_w  = tex_size.w
    self.detail_tex_h  = tex_size.h

    pcall(function()
        self.bg_map_canvas:InitTexture("tlra_map_global")
        self.bg_map_canvas:SetStretchTexture(true)
        self.bg_map_canvas:Show(true)

        if not self.is_transition and self.detail_tex_id then
            self.map_canvas:InitTexture(self.detail_tex_id)
            self.map_canvas:SetStretchTexture(true)
            self.map_canvas:Show(true)
        else
            self.map_canvas:Show(false)
        end
    end)

    -- Lock pawn marker at dead center of the 960x526 viewport: (480 - 14, 263 - 14) = (466, 249)
    self.pawn_marker:SetWndPos(vector2():set(497, 364))
    self.pawn_marker:Show(true)

    -- Build Road-Biased Waypoint Polyline (identical to PDA system dots)
    local dot_positions = nil
    if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra then
        dot_positions = zzzz_the_long_road_ahead.tlra.dot_positions
    end
    if (not dot_positions or #dot_positions == 0) and zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.build_navmesh_dots then
        dot_positions = zzzz_the_long_road_ahead.build_navmesh_dots(self.start_pos, self.dest_pos, 12)
    end
    self.dot_positions = dot_positions or {}

    self.waypoints = { self.start_pos }
    for _, dp in ipairs(self.dot_positions) do
        table.insert(self.waypoints, dp)
    end
    table.insert(self.waypoints, self.dest_pos)

    self.seg_lengths = {}
    self.cum_dist    = { 0 }
    local total_len = 0
    for i = 1, #self.waypoints - 1 do
        local d = self.waypoints[i]:distance_to(self.waypoints[i+1])
        self.seg_lengths[i] = d
        total_len = total_len + d
        self.cum_dist[i+1] = total_len
    end
    self.total_path_len = math.max(1, total_len)

    -- Initial travel heading
    local cur_pos, heading = self:GetPositionAlongRoute(0.0)
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Header Route Title
    local lvl_str = game.translate_string(self.level_name) or self.level_name
    if self.txt_title then self.txt_title:SetText("EXPEDITION: " .. string.upper(lvl_str)) end
    if self.txt_route then self.txt_route:SetText(string.format("ROUTE TREK: %dm | SAFE STRIDE ACTIVE", math.floor(self.travel_dist))) end
    if self.txt_pace then self.txt_pace:SetText("SLOW PACE / SCANNING") end

    -- Initialize road log messages
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)

    self:AddLog(string.format("%s - Departed staging outpost on foot.", t_str))
    self:AddLog(string.format("%s - Route plotted: following road corridor towards destination.", t_str))
    self:AddLog(string.format("%s - ALife Threat Radar scanning road ahead (100m radius).", t_str))
    self:AddLog(string.format("%s - Weather clear. Steady walking rhythm established.", t_str))

    self.encounter_modal:Show(false)

    -- Initial viewport projection update
    self:UpdateViewport(cur_pos, 0.0)
end

-- Interpolate position and heading along road waypoints using Catmull-Rom cubic splines
function UIRoadAheadTravelMap:GetPositionAlongRoute(ratio)
    if not self.waypoints or #self.waypoints < 2 then
        local cur_x = self.start_pos.x + (self.dest_pos.x - self.start_pos.x) * ratio
        local cur_z = self.start_pos.z + (self.dest_pos.z - self.start_pos.z) * ratio
        local cur_pos = vector():set(cur_x, self.start_pos.y, cur_z)
        local heading = math.atan2(self.dest_pos.x - self.start_pos.x, -(self.dest_pos.z - self.start_pos.z))
        return cur_pos, heading
    end

    local r = math.max(0.0, math.min(1.0, ratio or 0.0))
    local target_dist = r * self.total_path_len

    local n_pts = #self.waypoints
    for i = 1, n_pts - 1 do
        local d_start = self.cum_dist[i]
        local d_end   = self.cum_dist[i+1]
        if target_dist <= d_end or i == n_pts - 1 then
            local seg_len = math.max(0.001, self.seg_lengths[i])
            local t = math.max(0.0, math.min(1.0, (target_dist - d_start) / seg_len))

            -- 4 Control Points for Catmull-Rom cubic spline
            local p0 = (i > 1) and self.waypoints[i-1] or self.waypoints[1]
            local p1 = self.waypoints[i]
            local p2 = self.waypoints[i+1]
            local p3 = (i + 2 <= n_pts) and self.waypoints[i+2] or self.waypoints[n_pts]

            local t2 = t * t
            local t3 = t2 * t

            -- Catmull-Rom Position (passes exactly through waypoints with C1 continuity)
            local cur_x = 0.5 * ((2 * p1.x) +
                                (-p0.x + p2.x) * t +
                                (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 +
                                (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3)

            local cur_y = p1.y + (p2.y - p1.y) * t

            local cur_z = 0.5 * ((2 * p1.z) +
                                (-p0.z + p2.z) * t +
                                (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * t2 +
                                (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * t3)

            -- Exact Tangent Derivative for smooth continuous heading rotation
            local dx = 0.5 * ((-p0.x + p2.x) +
                             2 * (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t +
                             3 * (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t2)

            local dz = 0.5 * ((-p0.z + p2.z) +
                             2 * (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * t +
                             3 * (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * t2)

            local heading
            if math.abs(dx) > 0.0001 or math.abs(dz) > 0.0001 then
                heading = math.atan2(dx, -dz)
            else
                heading = math.atan2(p2.x - p1.x, -(p2.z - p1.z))
            end

            return vector():set(cur_x, cur_y, cur_z), heading
        end
    end

    local last = self.waypoints[n_pts]
    local prev = self.waypoints[math.max(1, n_pts - 1)]
    local heading = math.atan2(last.x - prev.x, -(last.z - prev.z))
    return vector():set(last.x, last.y, last.z), heading
end

-- Mathematical auto-centering and dual-layer viewport projection engine
function UIRoadAheadTravelMap:UpdateViewport(cur_pos, ratio)
    cur_pos = cur_pos or self.start_pos
    ratio   = ratio or 0.0

    local FW = 1024
    local FH = 768
    local CX = 512
    local CY = 384

    -- 1. Ensure Player Stalker Pawn remains locked dead-center at (497, 364)
    self.pawn_marker:SetWndPos(vector2():set(CX - 15, CY - 20))
    self.pawn_marker:Show(true)

    -- 2. Dynamic Zoom Scale: Tailored around expedition trek distance
    local trek_span = math.max(math.abs(self.dest_pos.x - self.start_pos.x) * (FH / FW), math.abs(self.dest_pos.z - self.start_pos.z))
    local span_y_m  = math.max(500, math.min(1600, trek_span * 1.5))
    local scale     = FH / span_y_m  -- Pixels on screen per world meter

    -- 3. Project Start Departure Marker relative to centered player
    local sx = CX + (self.start_pos.x - cur_pos.x) * scale
    local sy = CY - (self.start_pos.z - cur_pos.z) * scale
    if sx >= -12 and sx <= FW + 12 and sy >= -12 and sy <= FH + 12 then
        self.start_marker:SetWndPos(vector2():set(sx - 12, sy - 12))
        self.start_marker:Show(true)
    else
        self.start_marker:Show(false)
    end

    -- 4. Project Destination Marker relative to centered player
    local dx = CX + (self.dest_pos.x - cur_pos.x) * scale
    local dy = CY - (self.dest_pos.z - cur_pos.z) * scale
    if dx >= -13 and dx <= FW + 13 and dy >= -13 and dy <= FH + 13 then
        self.dest_marker:SetWndPos(vector2():set(dx - 17, dy - 17))
        self.dest_marker:Show(true)
    else
        self.dest_marker:Show(false)
    end

    -- 5. Project Breadcrumb Waypoint Dots along the actual road route
    local d_count = (self.dot_positions and #self.dot_positions) or 12
    for i = 1, 12 do
        if self.dot_positions and self.dot_positions[i] then
            local frac = i / (d_count + 1)
            if ratio >= frac then
                local dp = self.dot_positions[i]
                local px = CX + (dp.x - cur_pos.x) * scale
                local py = CY - (dp.z - cur_pos.z) * scale
                if px >= 0 and px <= FW and py >= 0 and py <= FH then
                    self.trail_dots[i]:SetWndPos(vector2():set(px - 8, py - 3))
                    self.trail_dots[i]:Show(true)
                else
                    self.trail_dots[i]:Show(false)
                end
            else
                self.trail_dots[i]:Show(false)
            end
        else
            self.trail_dots[i]:Show(false)
        end
    end

    -- 6. Detail Level Map: Auto-center on cur_pos and crop strictly inside (0, 0, FW, FH)
    if not self.is_transition and self.bounds then
        local bounds = self.bounds
        local tex_w = self.detail_tex_w or 2048
        local tex_h = self.detail_tex_h or 2048

        -- Virtual unclipped screen bounds of the full map
        local scr_left   = CX + (bounds.x1 - cur_pos.x) * scale
        local scr_right  = CX + (bounds.x2 - cur_pos.x) * scale
        local scr_top    = CY - (bounds.z2 - cur_pos.z) * scale
        local scr_bottom = CY - (bounds.z1 - cur_pos.z) * scale

        local total_w = math.max(1, scr_right - scr_left)
        local total_h = math.max(1, scr_bottom - scr_top)

        -- Scissor clip strictly inside the viewport frame
        local vis_left   = math.max(0, scr_left)
        local vis_top    = math.max(0, scr_top)
        local vis_right  = math.min(FW, scr_right)
        local vis_bottom = math.min(FH, scr_bottom)

        if vis_right > vis_left and vis_bottom > vis_top then
            local tex_u1 = ((vis_left - scr_left) / total_w) * tex_w
            local tex_v1 = ((vis_top - scr_top) / total_h) * tex_h
            local tex_u2 = ((vis_right - scr_left) / total_w) * tex_w
            local tex_v2 = ((vis_bottom - scr_top) / total_h) * tex_h

            tex_u1 = math.max(0, math.min(tex_w, tex_u1))
            tex_v1 = math.max(0, math.min(tex_h, tex_v1))
            tex_u2 = math.max(0, math.min(tex_w, tex_u2))
            tex_v2 = math.max(0, math.min(tex_h, tex_v2))

            self.map_canvas:SetWndPos(vector2():set(math.floor(vis_left), math.floor(vis_top)))
            self.map_canvas:SetWndSize(vector2():set(math.ceil(vis_right - vis_left), math.ceil(vis_bottom - vis_top)))
            self.map_canvas:SetTextureRect(Frect():set(tex_u1, tex_v1, tex_u2, tex_v2))
            self.map_canvas:Show(true)
        else
            self.map_canvas:Show(false)
        end
    else
        self.map_canvas:Show(false)
    end

    -- 7. Continuous Global Zone Map Background Layer: Synchronously auto-center beneath the level map
    if self.global_rect and self.global_canvas and self.bounds then
        local canvas = self.global_canvas
        local rect = self.global_rect
        local bounds = self.bounds
        local level_w = math.max(1, bounds.x2 - bounds.x1)
        local level_h = math.max(1, bounds.z2 - bounds.z1)

        local g_scale_x = 4096 / math.max(1, canvas.x2 - canvas.x1)
        local g_scale_y = 8192 / math.max(1, canvas.z2 - canvas.z1)
        local orig_gx   = (rect.x1 - canvas.x1) * g_scale_x
        local orig_gy   = (rect.z1 - canvas.z1) * g_scale_y
        local rect_w_px = (rect.x2 - rect.x1) * g_scale_x
        local rect_h_px = (rect.z2 - rect.z1) * g_scale_y

        local g_ppm_x = rect_w_px / level_w
        local g_ppm_z = rect_h_px / level_h

        local g_center_u = orig_gx + (cur_pos.x - bounds.x1) * g_ppm_x
        local g_center_v = orig_gy + (bounds.z2 - cur_pos.z) * g_ppm_z
        local g_half_u   = (FW / (2 * scale)) * g_ppm_x
        local g_half_v   = (FH / (2 * scale)) * g_ppm_z

        local g_win_l = g_center_u - g_half_u
        local g_win_t = g_center_v - g_half_v
        local g_win_r = g_center_u + g_half_u
        local g_win_b = g_center_v + g_half_v

        local g_cl_l = math.max(g_win_l, 0)
        local g_cl_t = math.max(g_win_t, 0)
        local g_cl_r = math.min(g_win_r, 4096)
        local g_cl_b = math.min(g_win_b, 8192)

        if g_cl_r > g_cl_l and g_cl_b > g_cl_t then
            local g_span_u = math.max(1, g_win_r - g_win_l)
            local g_span_v = math.max(1, g_win_b - g_win_t)
            local gfx1 = (g_cl_l - g_win_l) / g_span_u
            local gfy1 = (g_cl_t - g_win_t) / g_span_v
            local gfx2 = (g_cl_r - g_win_l) / g_span_u
            local gfy2 = (g_cl_b - g_win_t) / g_span_v

            self.bg_map_canvas:SetWndPos(vector2():set(math.floor(gfx1 * FW), math.floor(gfy1 * FH)))
            self.bg_map_canvas:SetWndSize(vector2():set(math.ceil((gfx2 - gfx1) * FW), math.ceil((gfy2 - gfy1) * FH)))
            self.bg_map_canvas:SetTextureRect(Frect():set(g_cl_l, g_cl_t, g_cl_r, g_cl_b))
            self.bg_map_canvas:Show(true)
        else
            self.bg_map_canvas:SetWndPos(vector2():set(0, 0))
            self.bg_map_canvas:SetWndSize(vector2():set(FW, FH))
            self.bg_map_canvas:SetTextureRect(Frect():set(0, 0, 4096, 8192))
            self.bg_map_canvas:Show(true)
        end
    else
        self.bg_map_canvas:SetWndPos(vector2():set(0, 0))
        self.bg_map_canvas:SetWndSize(vector2():set(FW, FH))
        self.bg_map_canvas:SetTextureRect(Frect():set(0, 0, 4096, 8192))
        self.bg_map_canvas:Show(true)
    end
end

-- Add entry to road log ticker
function UIRoadAheadTravelMap:AddLog(entry)
    table.insert(self.log_history, 1, entry)
    if #self.log_history > 10 then
        table.remove(self.log_history)
    end
    for i = 1, 5 do
        if self.txt_logs[i] then
            self.txt_logs[i]:SetText(self.log_history[i] or "")
        end
    end
end

-- Per-frame update
function UIRoadAheadTravelMap:Update()
    CUIScriptWnd.Update(self)
    if not self:IsShown() then return end

    local tlra_core = zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra
    if not tlra_core then return end

    if not tlra_core.is_traveling and not self.encounter_active then
        self:Close()
        return
    end

    if self.travel_paused then return end

    local current_dist = tlra_core.current_dist or 0
    local total_dist   = math.max(1, tlra_core.travel_dist or self.travel_dist or 1)
    local ratio        = math.min(current_dist / total_dist, 1.0)

    -- Interpolate physical traveler position along road waypoints
    local cur_pos, heading = self:GetPositionAlongRoute(ratio)

    -- Auto-center map viewport on interpolated position
    self:UpdateViewport(cur_pos, ratio)

    -- Smoothly rotate pawn heading
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Update progress text & gauge (250px total track width)
    local pct = math.floor(ratio * 100)
    self.txt_progress:SetText(string.format("%d%% (%dm / %dm)", pct, math.floor(current_dist), math.floor(total_dist)))
    self.progress_fill:SetWndSize(vector2():set(math.floor(250 * ratio), 12))

    -- Update accelerated world clock
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local tf = math.floor(level.get_time_factor() + 0.5)
    self.txt_clock:SetText(string.format("%02d:%02d [%dx SPEED]", h, m, tf))

    -- Update weather and environmental concealment rating
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local env_desc = "Clear Skies"
    local w_lower = string.lower(weather_name)
    if string.find(w_lower, "storm") or string.find(w_lower, "thunder") then
        env_desc = "Heavy Storm (Cover +15%)"
    elseif string.find(w_lower, "rain") or string.find(w_lower, "fog") then
        env_desc = "Rain / Fog (Cover +10%)"
    elseif string.find(w_lower, "cloud") then
        env_desc = "Overcast (Cover +5%)"
    elseif h < 5 or h >= 22 then
        env_desc = "Night Darkness (Cover +20%)"
    end
        if self.txt_env then self.txt_env:SetText("WEATHER: " .. string.upper(env_desc)) end

    local threat_desc = "LOW (Clear Route)"
    if self.encounter_active then
        threat_desc = "CRITICAL (Hostile Ambush!)"
    elseif string.find(w_lower, "storm") then
        threat_desc = "ELEVATED (Hazardous Weather)"
    elseif ratio > 0.2 and ratio < 0.8 then
        threat_desc = "HIGH (ALife Activity)"
    end
    if self.txt_threat_hud then self.txt_threat_hud:SetText("THREAT RISK: " .. threat_desc) end

    -- Ambient Roadside Recon Log Updates
    local step = math.floor(ratio * 8)
    if step > self.last_log_step then
        self.last_log_step = step
        local t_str = string.format("%02d:%02d", h, m)
        local logs = {
            [1] = string.format("%s - Moving along road corridor at steady walking pace.", t_str),
            [2] = string.format("%s - Terrain clear of anomalies. Stamina holding stable.", t_str),
            [3] = string.format("%s - Passing roadside landmarks... Maintaining low profile.", t_str),
            [4] = string.format("%s - Approaching journey midpoint. ALife Threat Radar scanning.", t_str),
            [5] = string.format("%s - Distant Zone ambient sounds recorded. Path remains unobstructed.", t_str),
            [6] = string.format("%s - Pushing through regional corridor. Destination in range.", t_str),
            [7] = string.format("%s - Slowing pace: visual acquisition of destination beacon.", t_str),
            [8] = string.format("%s - Arriving at destination outpost.", t_str),
        }
        if logs[step] then
            self:AddLog(logs[step])
        end
    end

    -- Update survival vitals
    self:UpdateSurvivalVitals()
end

function UIRoadAheadTravelMap:UpdateSurvivalVitals()
    local actor = db.actor
    if not actor then return end

    local cal_str = "Calories: 2,500 kcal"
    if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.get_diet_calories then
        pcall(function()
            local c = zzzz_the_long_road_ahead.get_diet_calories()
            if c then cal_str = string.format("Calories: %d kcal (-14 kcal/min)", math.floor(c)) end
        end)
    end
    self.txt_calories:SetText(cal_str)

    local hyd = 99
    pcall(function()
        if actor.thirst then
            hyd = math.floor(actor.thirst * 100)
        end
    end)
    self.txt_hydration:SetText(string.format("Hydration: %d%%", math.max(0, math.min(100, hyd))))

    local sta = 100
    pcall(function()
        if actor.power then
            sta = math.floor(actor.power * 100)
        end
    end)
    self.txt_stamina:SetText(string.format("Stamina: %d%%", math.max(0, math.min(100, sta))))

    local weight = 35.0
    pcall(function()
        if actor.get_total_weight then
            weight = math.floor(actor:get_total_weight() * 10) / 10
        end
    end)

    local max_w = 60.0
    pcall(function()
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.get_real_max_weight then
            max_w = zzzz_the_long_road_ahead.get_real_max_weight()
        elseif actor.get_actor_max_walk_weight then
            max_w = actor:get_actor_max_walk_weight()
        elseif actor.get_actor_max_weight then
            max_w = actor:get_actor_max_weight()
        end
    end)
    max_w = math.floor(max_w * 10) / 10

        if self.txt_encumbrance then self.txt_encumbrance:SetText(string.format("PACK: %.1f kg / %.0f kg [Stride: 3.4 m/s]", weight, max_w)) end

    local rad = 0.0
    pcall(function()
        if actor.radiation then rad = math.max(0.0, actor.radiation * 0.1) end
    end)
    if self.txt_rad then self.txt_rad:SetText(string.format("RADIATION: %.2f mSv", rad)) end

    local psy = 1.0
    pcall(function()
        if actor.psy_health then psy = math.max(0.0, math.min(1.0, actor.psy_health)) end
    end)
    if self.psy_fill then
        self.psy_fill:SetWndSize(vector2():set(math.floor(83 * psy), 10))
    end
end

-- ===================================================================
-- INTERACTIVE ROAD ENCOUNTER LOGIC (Kingdom Come: Deliverance Style)
-- ===================================================================
function UIRoadAheadTravelMap:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    self.travel_paused = true
    self.encounter_active = true
    self.on_evade_cb = on_evade_cb
    self.on_engage_cb = on_engage_cb
    self.evasion_chance = evasion_chance or 50

    if self.snd_alarm then
        self.snd_alarm:play(db.actor, 0, sound_object.s2d)
    end

    self.txt_threat_title:SetText("HOSTILE CONTACT DETECTED ON ROAD!")
    self.txt_threat_desc:SetText(string.format("Intercepting ALife Force: %s", threat_name or "Unknown Hostile Squad"))
    self.txt_threat_range:SetText(string.format("Estimated Proximity: %dm Ahead", math.floor(threat_dist or 80)))

    local h = level.get_time_hours()
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local mods = {}
    if h < 5 or h >= 22 then table.insert(mods, "Night Darkness (+20%)") end
    if string.find(string.lower(weather_name), "rain") or string.find(string.lower(weather_name), "fog") then
        table.insert(mods, "Storm/Fog Cover (+10%)")
    end
    local mod_text = #mods > 0 and table.concat(mods, " + ") or "Standard Visibility (No modifiers)"
    self.txt_threat_stealth_info:SetText("Tactical Cover: " .. mod_text)

    self.txt_evasion_odds:SetText(string.format("STEALTH EVASION: %d%%", self.evasion_chance))
    self.encounter_modal:Show(true)

    local t_str = string.format("%02d:%02d", h, level.get_time_minutes())
    self:AddLog(string.format("%s - [ALERT] %s spotted ahead (%dm)!", t_str, threat_name or "Hostile", math.floor(threat_dist or 80)))
end

function UIRoadAheadTravelMap:OnAttemptEvade()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local roll = math.random(1, 100)
    local success = roll <= self.evasion_chance

    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)

    if success then
        if self.snd_evade then self.snd_evade:play(db.actor, 0, sound_object.s2d) end
        self:AddLog(string.format("%s - [SUCCESS] Slipped past hostiles undetected!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self.travel_paused = false
        if self.on_evade_cb then
            self.on_evade_cb(true)
        end
    else
        self:AddLog(string.format("%s - [FAILED] Ambush! Enemies spotted you!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self:Close()
        if self.on_evade_cb then
            self.on_evade_cb(false)
        end
    end
end

function UIRoadAheadTravelMap:OnDropAndFight()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)
    self:AddLog(string.format("%s - Dropping out to engage hostile contact!", t_str))

    self.encounter_modal:Show(false)
    self.encounter_active = false
    self:Close()

    if self.on_engage_cb then
        self.on_engage_cb()
    end
end

function UIRoadAheadTravelMap:OnHaltClicked()
    self:Close()
    if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.abort_travel_safe then
        zzzz_the_long_road_ahead.abort_travel_safe()
    end
end

function UIRoadAheadTravelMap:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            if self.encounter_active then
                self:OnDropAndFight()
            else
                self:OnHaltClicked()
            end
            return true
        end
    end
    return res
end

function UIRoadAheadTravelMap:Close()
    if self:IsShown() then
        self:HideDialog()
        Unregister_UI("UIRoadAheadTravelMap")
    end
    self.travel_paused = false
    self.encounter_active = false

    -- Remove post-processing blackout effector
    pcall(function()
        level.remove_pp_effector(8877)
    end)

    -- Ensure weapon & input state is unconditionally cleared on map close
    pcall(function()
        if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
        if game and game.can_select_weapon then game.can_select_weapon(true) end
        if game and game.actor_lower_weapon then game.actor_lower_weapon(false) end
        if game and game.stop_hud_motion then game.stop_hud_motion() end
        if level then level.enable_input(); level.show_weapon(true) end
        pcall(function() exec_console_cmd("hud_weapon 1") end)
        if xr_effects and xr_effects.enable_ui then pcall(xr_effects.enable_ui, db.actor, nil) end
        -- restore_weapon omitted
    end)

    GUI = nil
end

-- ===================================================================
-- GLOBAL ACCESS API
-- ===================================================================
function is_open()
    return GUI ~= nil and GUI:IsShown()
end

function show_map(start_pos, dest_pos, level_name, is_transition, travel_dist)
    if not GUI then
        GUI = UIRoadAheadTravelMap()
    end

    -- Engage full screen post-processing blackout shader
    pcall(function()
        level.add_pp_effector("sleep_fade.ppe", 8877, false)
    end)

    GUI:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist)
    GUI:ShowDialog(true)
    Register_UI("UIRoadAheadTravelMap", "ui_tlra_travel_map")
    return GUI
end

function close_map()
    if GUI and GUI:IsShown() then
        GUI:Close()
    else
        pcall(function()
            level.remove_pp_effector(8877)
            if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
            if game and game.can_select_weapon then game.can_select_weapon(true) end
            if level then level.enable_input(); level.show_weapon(true) end
        pcall(function() exec_console_cmd("hud_weapon 1") end)
        if xr_effects and xr_effects.enable_ui then pcall(xr_effects.enable_ui, db.actor, nil) end
        end)
    end
end

function trigger_encounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    if GUI and GUI:IsShown() then
        GUI:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
        return true
    end
    return false
end
