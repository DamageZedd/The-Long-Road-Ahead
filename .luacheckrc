-- luacheck config for TLRA (X-Ray / Anomaly Lua 5.1 / LuaJIT).
-- Globals were derived from luacheck output on the real scripts:
--   globals      = names the mod scripts define/mutate at top level (X-Ray scripts are modules whose
--                  public functions are globals, plus a few engine tables the mod extends)
--   read_globals = engine API and other scripts/modules referenced but not defined here
std = "luajit"
max_line_length = false
globals = {
    "GUI",
    "UIRoadAheadTravelMap",
    "abort_travel_safe",
    "actor_on_before_hit",
    "actor_on_first_update",
    "actor_on_update",
    "actor_status_sleep",
    "actor_status_thirst",
    "apply_final_stats",
    "build_cross_zone_route",
    "build_navmesh_dots",
    "check_and_skip_surges",
    "cleanup_dots",
    "close_map",
    "complete_travel_sequence",
    "coord_to_global_uv",
    "db",
    "detect_ambush",
    "find_door_to",
    "find_door_to_legacy",
    "find_road_path",
    "find_zone_path",
    "game_fast_travel",
    "get_config",
    "get_custom_route_polyline",
    "get_diet_calories",
    "get_global_bounds",
    "get_level_bounds",
    "get_level_global_rect",
    "get_level_road_nodes",
    "global_uv_to_coord",
    "init_zone_map_coordinates",
    "is_open",
    "is_safety_active",
    "is_same_level_spot",
    "on_before_fast_travel",
    "on_game_start",
    "on_key_press",
    "on_key_release",
    "on_loading_screen_dismissed",
    "on_map_spot_menu_add_property",
    "on_map_spot_menu_property_clicked",
    "on_mcm_load",
    "on_mouse_wheel",
    "on_option_change",
    "open_planner",
    "open_route_planner",
    "polyline_length",
    "polyline_point_at",
    "process_refund",
    "purge_orphan_dots",
    "ranks",
    "set_safety_active",
    "show_map",
    "snap_route_point",
    "spawn_dot",
    "start_travel_sequence",
    "stop_travel_logic",
    "teleport_companions",
    "tlra_is_traveling",
    "trader_autoinject",
    "trigger_encounter",
    "zzz_player_injuries",
}
read_globals = {
    "AC_ID",
    "ActorMenu",
    "CScriptXmlInit",
    "CUIScriptWnd",
    "ChangeLevel",
    "CreateTimeEvent",
    "DIK_keys",
    "Frect",
    "GetCursorPosition",
    "IsAnomaly",
    "IsMonster",
    "IsStalker",
    "IsWeapon",
    "RegisterScriptCallback",
    "Register_UI",
    "SIMBOARD",
    "UnregisterScriptCallback",
    "Unregister_UI",
    "actor_menu",
    "alife",
    "alife_create",
    "alife_create_item",
    "alife_object",
    "alife_release",
    "axr_companions",
    "axr_task_manager",
    "class",
    "clsid",
    "diet_system",
    "exec_console_cmd",
    "game",
    "game_graph",
    "game_ini",
    "game_object",
    "getFS",
    "get_object_squad",
    "has_alife_info",
    "hide_hud_all",
    "hide_hud_pda",
    "ini_file",
    "level",
