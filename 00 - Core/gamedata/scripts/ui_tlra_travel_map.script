-- Safe sound object loader
local function safe_sound(snd_path)
    local snd = nil
    pcall(function()
        snd = sound_object(snd_path)
    end)
    return snd
end

-- Safely retrieve game_maps_single.ltx ini interface
local function get_maps_ini()
    local ini = nil
    pcall(function() ini = game_ini() end)
    if not ini or not (ini.section_exist and ini:section_exist("global_map")) then
        pcall(function() ini = ini_file("game_maps_single.ltx") end)
    end
    return ini
end

-- Parse level bound_rect string into coordinate numbers
local function parse_bound_rect(raw)
    if type(raw) ~= "string" then return nil end
    local x1, z1, x2, z2 = string.match(raw, "^%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)")
    x1, z1, x2, z2 = tonumber(x1), tonumber(z1), tonumber(x2), tonumber(z2)
    if not (x1 and z1 and x2 and z2) then return nil end
    if x2 <= x1 or z2 <= z1 then return nil end
    return { x1 = x1, z1 = z1, x2 = x2, z2 = z2 }
end

-- Read level bounds from game configs or fallback table
function get_level_bounds(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local bounds = nil

    -- 1. Try reading bound_rect from maps ini
    local ini = get_maps_ini()
    local candidates = LEVEL_SECTION_NAMES[level_name] or { level_name }
    if ini then
        for _, sec in ipairs(candidates) do
            if ini:section_exist(sec) then
                local raw = ini:r_string_ex(sec, "bound_rect")
                if raw then
                    bounds = parse_bound_rect(raw)
                    if bounds then break end
                end
            end
        end
    end

    -- 2. Try reading from level.ltx
    if not bounds then
        pcall(function()
            local fs = getFS()
            if fs and fs.r_open then
                for _, sec in ipairs(candidates) do
                    local reader = fs:r_open("$game_levels$", sec .. "/level.ltx")
                    if reader then
                        local l_ini = ini_file(reader, "$game_levels$")
                        if l_ini and l_ini:section_exist("level_map") then
                            local raw = l_ini:r_string_ex("level_map", "bound_rect")
                            if raw then bounds = parse_bound_rect(raw) end
                        end
                        if bounds then break end
                    end
                end
            end
        end)
    end

    -- 3. Pre-cached fallback table
    if not bounds then
        for _, sec in ipairs(candidates) do
            if FALLBACK_LEVEL_BOUNDS[sec] then
                bounds = FALLBACK_LEVEL_BOUNDS[sec]
                break
            end
        end
    end

    return bounds
end

-- Read global Zone map canvas bounds
function get_global_bounds()
    local canvas = nil
    local ini = get_maps_ini()
    if ini and ini:section_exist("global_map") then
        local raw = ini:r_string_ex("global_map", "bound_rect")
        if raw then canvas = parse_bound_rect(raw) end
    end
    return canvas or { x1 = 0, z1 = 0, x2 = 1000, z2 = 2000 }
end

-- Read level placement rectangle on global Zone map
function get_level_global_rect(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local ini = get_maps_ini()
    if not ini then return nil end
    local candidates = LEVEL_SECTION_NAMES[level_name] or { level_name }
    for _, sec in ipairs(candidates) do
        if ini:section_exist(sec) then
            local raw = ini:r_string_ex(sec, "global_rect")
            if raw then
                local rect = parse_bound_rect(raw)
                if rect then return rect end
            end
        end
    end
    return nil
end

-- Convert level-local coordinates into 4096x8192 global Zone map pixel coordinates (u, v)
function coord_to_global_uv(pos, lvl_name)
    lvl_name = lvl_name or (level and level.name and level.name())
    local bounds = get_level_bounds(lvl_name)
    local rect   = get_level_global_rect(lvl_name)
    local canvas = get_global_bounds()
    if not (bounds and rect and canvas and pos) then
        return vector2():set(2048, 4096)
    end

    local g_scale_x = 4096 / math.max(1, canvas.x2 - canvas.x1)
    local g_scale_y = 8192 / math.max(1, canvas.z2 - canvas.z1)
    local orig_gx   = (rect.x1 - canvas.x1) * g_scale_x
    local orig_gy   = (rect.z1 - canvas.z1) * g_scale_y
    local rect_w_px = (rect.x2 - rect.x1) * g_scale_x
    local rect_h_px = (rect.z2 - rect.z1) * g_scale_y

    local g_ppm_x = rect_w_px / math.max(1, bounds.x2 - bounds.x1)
    local g_ppm_z = rect_h_px / math.max(1, bounds.z2 - bounds.z1)

    local u = orig_gx + (pos.x - bounds.x1) * g_ppm_x
    local v = orig_gy + (bounds.z2 - pos.z) * g_ppm_z
    return vector2():set(u, v)
end

-- ===================================================================
-- UI WINDOW CLASS
-- ===================================================================
class "UIRoadAheadTravelMap" (CUIScriptWnd)

function UIRoadAheadTravelMap:__init() super()
    self.travel_paused      = false
    self.encounter_active   = false
    self.last_log_step      = 0
    self.log_history        = {}
    self.waypoints          = {}
    self.seg_lengths        = {}
    self.cum_dist           = { 0 }
    self.total_path_len     = 1
    self.user_zoom          = 1.0
    self.last_zoom_time     = 0
    self.dest_level_name    = nil
    self.level_canvases     = {}
    self.level_grects       = {}
    self.dot_gpositions     = {}

    -- Sound feedback
    self.snd_alarm  = safe_sound("detectors/contact_1")
    self.snd_evade  = safe_sound("interface/mp_reward")
    self.snd_click  = safe_sound("interface/inv_open")

    self:InitControls()
    self:InitCallbacks()
end

function UIRoadAheadTravelMap:AdjustZoom(delta)
    if self.encounter_active then return end

    local now = (time_global and time_global()) or (time_continual and time_continual()) or 0
    if self.last_zoom_time and (now - self.last_zoom_time < 20) then
        return
    end
    self.last_zoom_time = now

    local current = self.user_zoom or 1.0
    if delta > 0 then
        self.user_zoom = math.min(10.0, current * 1.15)
    elseif delta < 0 then
        self.user_zoom = math.max(0.20, current * 0.87)
    end

    pcall(function()
        local tlra_core = zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra
        local ratio = 0.0
        if tlra_core and tlra_core.travel_dist and tlra_core.travel_dist > 0 then
            ratio = math.min((tlra_core.current_dist or 0) / tlra_core.travel_dist, 1.0)
        end
        local cur_pos, _ = self:GetPositionAlongRoute(ratio)
        self:UpdateViewport(cur_pos, ratio)
    end)
end

function UIRoadAheadTravelMap:OnMouseScroll(iDirection)
    if iDirection > 0 then
        self:AdjustZoom(1)
    elseif iDirection < 0 then
        self:AdjustZoom(-1)
    end
end

function UIRoadAheadTravelMap:__finalize()
    GUI = nil
end

function UIRoadAheadTravelMap:InitControls()
    -- Exact standard 1024x768 virtual coordinates
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_tlra_travel_map.xml")

    -- Solid pitch-black backdrop (Covers ultrawide & multi-monitor setups)
    self.bg = xml:InitStatic("background", self)
    pcall(function()
        self.bg:SetWndRect(Frect():set(-1200, -600, 3424, 1968))
    end)

    -- 1. Fullscreen Map Viewport Frame (1024x768)
    self.map_frame          = xml:InitStatic("map_frame", self)
    self.map_frame_bg       = xml:InitStatic("map_frame:map_frame_bg", self.map_frame)

    -- Layer 1: Continuous Zone Global Base Map
    self.bg_map_canvas      = xml:InitStatic("map_frame:bg_map_canvas", self.map_frame)
    self.bg_map_canvas:SetStretchTexture(true)

    -- Layer 2: All 22 Regional Level Maps Loaded Simultaneously
    self.level_canvases = {}
    for _, lvl in ipairs(ZONE_LEVEL_LIST) do
        local tex_id = LEVEL_MAP_TEXTURES[lvl]
        if tex_id then
            local st = xml:InitStatic("map_frame:level_canvas", self.map_frame)
            if st then
                st:InitTexture(tex_id)
                st:SetStretchTexture(true)
                st:Show(false)
                self.level_canvases[lvl] = st
            end
        end
    end

    -- Detail Regional Level Map (Legacy Fallback)
    self.map_canvas         = xml:InitStatic("map_frame:map_canvas", self.map_frame)
    if self.map_canvas then
        self.map_canvas:SetStretchTexture(true)
        self.map_canvas:Show(false)
    end

    -- Markers & Waypoint Icons
    self.start_marker       = xml:InitStatic("map_frame:start_marker", self.map_frame)
    self.dest_marker        = xml:InitStatic("map_frame:dest_marker", self.map_frame)

    self.trail_dots = {}
    for i = 1, 12 do
        self.trail_dots[i]  = xml:InitStatic("map_frame:trail_dot_" .. i, self.map_frame)
        self.trail_dots[i]:Show(false)
    end

    self.pawn_marker        = xml:InitStatic("map_frame:pawn_marker", self.map_frame)

    -- 2. Top-Left: Expedition Dossier Index Card
    self.dossier_tab        = xml:InitStatic("dossier_tab", self)
    self.dossier_bg         = xml:InitStatic("dossier_tab:dossier_bg", self.dossier_tab)
    xml:InitStatic("dossier_tab:dossier_bt", self.dossier_tab)
    xml:InitStatic("dossier_tab:dossier_bb", self.dossier_tab)
    xml:InitStatic("dossier_tab:dossier_bl", self.dossier_tab)
    xml:InitStatic("dossier_tab:dossier_br", self.dossier_tab)
    xml:InitStatic("dossier_tab:dossier_top_bar", self.dossier_tab)
    self.txt_title          = xml:InitTextWnd("dossier_tab:txt_title", self.dossier_tab)
    self.txt_route_info     = xml:InitTextWnd("dossier_tab:txt_route", self.dossier_tab)
    self.txt_pace           = xml:InitTextWnd("dossier_tab:txt_pace", self.dossier_tab)

    -- 3. Top-Center: Environmental Telemetry Strip
    self.top_center         = xml:InitStatic("top_center", self)
    self.top_center_bg      = xml:InitStatic("top_center:top_center_bg", self.top_center)
    xml:InitStatic("top_center:top_center_bt", self.top_center)
    xml:InitStatic("top_center:top_center_bb", self.top_center)
    xml:InitStatic("top_center:top_center_bl", self.top_center)
    xml:InitStatic("top_center:top_center_br", self.top_center)
    self.txt_clock          = xml:InitTextWnd("top_center:txt_clock", self.top_center)
    self.txt_env            = xml:InitTextWnd("top_center:txt_weather", self.top_center)
    self.txt_threat_hud     = xml:InitTextWnd("top_center:txt_threat", self.top_center)

    -- 4. Top-Right: Trip Progress & Dual Gauges
    self.top_right          = xml:InitStatic("top_right", self)
    self.top_right_bg       = xml:InitStatic("top_right:top_right_bg", self.top_right)
    xml:InitStatic("top_right:top_right_bt", self.top_right)
    xml:InitStatic("top_right:top_right_bb", self.top_right)
    xml:InitStatic("top_right:top_right_bl", self.top_right)
    xml:InitStatic("top_right:top_right_br", self.top_right)
    self.txt_progress       = xml:InitTextWnd("top_right:txt_progress", self.top_right)
    self.progress_border    = xml:InitStatic("top_right:progress_border", self.top_right)
    self.progress_bg        = xml:InitStatic("top_right:progress_bg", self.top_right)
    self.progress_fill      = xml:InitStatic("top_right:progress_fill", self.top_right)
    self.threat_border      = xml:InitStatic("top_right:threat_border", self.top_right)
    self.threat_bg          = xml:InitStatic("top_right:threat_bg", self.top_right)
    self.threat_fill        = xml:InitStatic("top_right:threat_fill", self.top_right)

    -- 5. Bottom-Left: Floating Survival Metabolism Telemetry
    self.vitals_panel       = xml:InitStatic("vitals_panel", self)
    self.vitals_bg          = xml:InitStatic("vitals_panel:vitals_bg", self.vitals_panel)
    xml:InitStatic("vitals_panel:vitals_bt", self.vitals_panel)
    xml:InitStatic("vitals_panel:vitals_bb", self.vitals_panel)
    xml:InitStatic("vitals_panel:vitals_bl", self.vitals_panel)
    xml:InitStatic("vitals_panel:vitals_br", self.vitals_panel)
    xml:InitStatic("vitals_panel:vitals_hdr_bg", self.vitals_panel)
    xml:InitTextWnd("vitals_panel:vitals_hdr_txt", self.vitals_panel)
    self.txt_calories       = xml:InitTextWnd("vitals_panel:txt_calories", self.vitals_panel)
    self.txt_hydration      = xml:InitTextWnd("vitals_panel:txt_hydration", self.vitals_panel)
    self.txt_stamina        = xml:InitTextWnd("vitals_panel:txt_stamina", self.vitals_panel)
    self.txt_encumbrance    = xml:InitTextWnd("vitals_panel:txt_encumbrance", self.vitals_panel)
    self.txt_rad            = xml:InitTextWnd("vitals_panel:txt_rad", self.vitals_panel)
    self.txt_psy            = xml:InitTextWnd("vitals_panel:txt_psy", self.vitals_panel)
    xml:InitStatic("vitals_panel:psy_border", self.vitals_panel)
    xml:InitStatic("vitals_panel:psy_bg", self.vitals_panel)
    self.psy_fill           = xml:InitStatic("vitals_panel:psy_fill", self.vitals_panel)

    -- 6. Bottom-Center: Authentic Road Reconnaissance Log
    self.journal_card       = xml:InitStatic("journal_card", self)
    self.journal_bg         = xml:InitStatic("journal_card:journal_bg", self.journal_card)
    xml:InitStatic("journal_card:journal_bt", self.journal_card)
    xml:InitStatic("journal_card:journal_bb", self.journal_card)
    xml:InitStatic("journal_card:journal_bl", self.journal_card)
    xml:InitStatic("journal_card:journal_br", self.journal_card)
    xml:InitStatic("journal_card:journal_hdr_bg", self.journal_card)
    xml:InitTextWnd("journal_card:journal_hdr_txt", self.journal_card)
    self.txt_logs = {}
    for i = 1, 5 do
        self.txt_logs[i] = xml:InitTextWnd("journal_card:txt_log_" .. i, self.journal_card)
    end

    -- 7. Bottom-Right: Heavy Industrial Command Panel
    self.action_panel       = xml:InitStatic("action_panel", self)
    self.action_bg          = xml:InitStatic("action_panel:action_bg", self.action_panel)
    xml:InitStatic("action_panel:action_bt", self.action_panel)
    xml:InitStatic("action_panel:action_bb", self.action_panel)
    xml:InitStatic("action_panel:action_bl", self.action_panel)
    xml:InitStatic("action_panel:action_br", self.action_panel)
    xml:InitStatic("action_panel:action_hdr_bg", self.action_panel)
    xml:InitTextWnd("action_panel:action_hdr_txt", self.action_panel)
    self.btn_halt           = xml:Init3tButton("action_panel:btn_halt", self.action_panel)
    self:Register(self.btn_halt, "btn_halt")
    xml:InitTextWnd("action_panel:txt_halt_sub", self.action_panel)

    -- KCD Ambush / Threat Decision Modal Card
    self.encounter_modal        = xml:InitStatic("encounter_modal", self)
    self.modal_bg               = xml:InitStatic("encounter_modal:modal_bg", self.encounter_modal)
    self.modal_top_line         = xml:InitStatic("encounter_modal:modal_top_line", self.encounter_modal)
    self.modal_bot_line         = xml:InitStatic("encounter_modal:modal_bot_line", self.encounter_modal)
    self.modal_left_line        = xml:InitStatic("encounter_modal:modal_left_line", self.encounter_modal)
    self.modal_right_line       = xml:InitStatic("encounter_modal:modal_right_line", self.encounter_modal)
    self.txt_threat_title       = xml:InitTextWnd("encounter_modal:txt_threat_title", self.encounter_modal)
    self.txt_threat_desc        = xml:InitTextWnd("encounter_modal:txt_threat_desc", self.encounter_modal)
    self.txt_threat_range       = xml:InitTextWnd("encounter_modal:txt_threat_range", self.encounter_modal)
    self.txt_threat_stealth_info= xml:InitTextWnd("encounter_modal:txt_threat_stealth_info", self.encounter_modal)

    self.evasion_box            = xml:InitStatic("encounter_modal:evasion_box", self.encounter_modal)
    self.evasion_bg             = xml:InitStatic("encounter_modal:evasion_box:evasion_bg", self.evasion_box)
    self.evasion_top_line       = xml:InitStatic("encounter_modal:evasion_box:evasion_top_line", self.evasion_box)
    self.evasion_bot_line       = xml:InitStatic("encounter_modal:evasion_box:evasion_bot_line", self.evasion_box)
    self.txt_evasion_odds       = xml:InitTextWnd("encounter_modal:evasion_box:txt_evasion_odds", self.evasion_box)

    self.btn_attempt_evade      = xml:Init3tButton("encounter_modal:btn_attempt_evade", self.encounter_modal)
    self:Register(self.btn_attempt_evade, "btn_attempt_evade")
    self.btn_attempt_evade:Enable(true)

    self.btn_drop_and_fight     = xml:Init3tButton("encounter_modal:btn_drop_and_fight", self.encounter_modal)
    self:Register(self.btn_drop_and_fight, "btn_drop_and_fight")
    self.btn_drop_and_fight:Enable(true)

    self.btn_halt:Enable(true)
    self:Enable(true)

    -- Initially hide encounter card
    self.encounter_modal:Show(false)
end

function UIRoadAheadTravelMap:InitCallbacks()
    self:AddCallback("btn_halt", ui_events.BUTTON_CLICKED, self.OnHaltClicked, self)
    self:AddCallback("btn_attempt_evade", ui_events.BUTTON_CLICKED, self.OnAttemptEvade, self)
    self:AddCallback("btn_drop_and_fight", ui_events.BUTTON_CLICKED, self.OnDropAndFight, self)
end

local function to_coords(p)
    if not p then return 0.0, 0.0 end
    local ok_x, x = pcall(function() return p.x end)
    local ok_z, z = pcall(function() return p.z end)
    if ok_x and x and ok_z and z then
        return x, z
    end
    local ok_y, y = pcall(function() return p.y end)
    if ok_x and x and ok_y and y and (not ok_z or not z) then
        return x, y
    end
    if type(p) == "table" then
        local tx = p.x or p[1] or 0.0
        local tz = p.z or p[3] or p.y or p[2] or 0.0
        return tx, tz
    end
    return 0.0, 0.0
end

local function to_vector(p)
    if not p then return vector():set(0, 0, 0) end
    local ok_x, x = pcall(function() return p.x end)
    local ok_y, y = pcall(function() return p.y end)
    local ok_z, z = pcall(function() return p.z end)
    if ok_x and x and ok_y and y and ok_z and z then
        return vector():set(x, y, z)
    end
    local tx = (type(p) == "table" and (p.x or p[1])) or 0.0
    local ty = (type(p) == "table" and (p.y or p[2])) or 0.0
    local tz = (type(p) == "table" and (p.z or p[3])) or 0.0
    return vector():set(tx, ty, tz)
end

-- Setup and launch expedition display with all map textures loaded simultaneously
local function catmull_rom_spline(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t

    local x0, z0 = to_coords(p0)
    local x1, z1 = to_coords(p1)
    local x2, z2 = to_coords(p2)
    local x3, z3 = to_coords(p3)

    local x = 0.5 * ((2 * x1) +
                     (-x0 + x2) * t +
                     (2 * x0 - 5 * x1 + 4 * x2 - x3) * t2 +
                     (-x0 + 3 * x1 - 3 * x2 + x3) * t3)
    local z = 0.5 * ((2 * z1) +
                     (-z0 + z2) * t +
                     (2 * z0 - 5 * z1 + 4 * z2 - z3) * t2 +
                     (-z0 + 3 * z1 - 3 * z2 + z3) * t3)

    local dx = 0.5 * ((-x0 + x2) +
                      2 * (2 * x0 - 5 * x1 + 4 * x2 - x3) * t +
                      3 * (-x0 + 3 * x1 - 3 * x2 + x3) * t2)
    local dz = 0.5 * ((-z0 + z2) +
                      2 * (2 * z0 - 5 * z1 + 4 * z2 - z3) * t +
                      3 * (-z0 + 3 * z1 - 3 * z2 + z3) * t2)

    local heading = math.atan2(dx, -dz)
    return vector():set(x, 0, z), heading
end

-- Setup and launch expedition display with true physical scale and multi-level cartography
function UIRoadAheadTravelMap:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    self.start_pos       = to_vector(start_pos or (db.actor and db.actor:position()))
    self.dest_pos        = to_vector(dest_pos or self.start_pos)
    self.level_name      = level_name or (level and level.name and level.name()) or "escape"
    self.dest_level_name = dest_level_name or self.level_name
    self.is_transition   = is_transition or false
    self.travel_dist     = travel_dist or math.max(1, self.start_pos:distance_to(self.dest_pos))
    self.travel_paused   = false
    self.encounter_active = false
    self.last_log_step   = 0
    self.log_history     = {}
    self.user_zoom       = 1.0

    -- Load geographic map coordinates
    self.bounds          = get_level_bounds(self.level_name)
    self.global_canvas   = get_global_bounds()
    self.global_rect     = get_level_global_rect(self.level_name)

    -- Initialize map textures
    if not self.is_transition then
        local tex_id = LEVEL_MAP_TEXTURES[self.level_name] or LEVEL_MAP_TEXTURES["escape"]
        if tex_id and self.map_canvas then
            pcall(function()
                self.map_canvas:InitTexture(tex_id)
                self.map_canvas:SetStretchTexture(true)
                self.map_canvas:Show(true)
            end)
        end
    else
        if self.map_canvas then
            self.map_canvas:Show(false)
        end
    end

    pcall(function()
        self.bg_map_canvas:InitTexture("tlra_map_global")
        self.bg_map_canvas:SetStretchTexture(true)
    end)

    -- Lock pawn marker at dead center (512 - 14, 384 - 14)
    self.pawn_marker:SetWndPos(vector2():set(498, 370))
    self.pawn_marker:Show(true)

    local FW = 1024
    local FH = 768

    if not self.is_transition then
        -- Same-level local expedition: True Physical World Meter Coordinates
        local road_path = nil
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.find_road_path then
            road_path = zzzz_the_long_road_ahead.find_road_path(self.start_pos, self.dest_pos, self.level_name)
        end

        local waypoints = {}
        if road_path and #road_path >= 2 then
            for _, pt in ipairs(road_path) do
                local v = to_vector(pt)
                table.insert(waypoints, vector():set(v.x, 0, v.z))
            end
        else
            table.insert(waypoints, vector():set(self.start_pos.x, 0, self.start_pos.z))
            local dot_positions = nil
            if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra then
                dot_positions = zzzz_the_long_road_ahead.tlra.dot_positions
            end
            if (not dot_positions or #dot_positions == 0) and zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.build_navmesh_dots then
                dot_positions = zzzz_the_long_road_ahead.build_navmesh_dots(self.start_pos, self.dest_pos, 12, self.level_name)
            end
            if dot_positions then
                for _, dp in ipairs(dot_positions) do
                    local vdp = to_vector(dp)
                    table.insert(waypoints, vector():set(vdp.x, 0, vdp.z))
                end
            end
            table.insert(waypoints, vector():set(self.dest_pos.x, 0, self.dest_pos.z))
        end

        self.waypoints = waypoints
        self.seg_lengths = {}
        self.cum_dist    = { 0 }
        local total_len = 0
        for i = 1, #self.waypoints - 1 do
            local d = self.waypoints[i]:distance_to(self.waypoints[i+1])
            self.seg_lengths[i] = d
            total_len = total_len + d
            self.cum_dist[i+1] = total_len
        end
        self.total_path_len = math.max(1, total_len)

        self.dot_positions = {}
        for i = 1, 12 do
            local frac = i / 13
            local pt, _ = self:GetPositionAlongRoute(frac)
            self.dot_positions[i] = vector():set(pt.x, 0, pt.z)
        end

        -- Calculate tactical base scale: spans ~400m to 1200m comfortably on 1024x768 screen
        local dx = math.abs(self.dest_pos.x - self.start_pos.x) * (FH / FW)
        local dz = math.abs(self.dest_pos.z - self.start_pos.z)
        local trek_span_m = math.max(dx, dz)
        local span_y_m = math.max(380, math.min(1200, trek_span_m * 1.35))
        self.base_scale = FH / span_y_m
    else
        -- Cross-zone expedition waypoints in unified global UV space
        self.start_gpos = coord_to_global_uv(self.start_pos, self.level_name)
        self.dest_gpos  = coord_to_global_uv(self.dest_pos, self.dest_level_name)

        local cross_route = nil
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.build_cross_zone_route then
            cross_route = zzzz_the_long_road_ahead.build_cross_zone_route(self.level_name, self.dest_level_name, self.start_pos, self.dest_pos)
        end

        local waypoints = {}
        self.route_node_info = {}
        if cross_route and #cross_route >= 2 then
            for idx, pt in ipairs(cross_route) do
                table.insert(waypoints, vector():set(pt.x, 0, pt.z))
                self.route_node_info[idx] = pt.lvl or self.level_name
            end
        else
            table.insert(waypoints, vector():set(self.start_gpos.x, 0, self.start_gpos.y))
            if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra and zzzz_the_long_road_ahead.tlra.first_door_pos then
                local door_uv = coord_to_global_uv(zzzz_the_long_road_ahead.tlra.first_door_pos, self.level_name)
                if door_uv then
                    table.insert(waypoints, vector():set(door_uv.x, 0, door_uv.y))
                end
            end
            table.insert(waypoints, vector():set(self.dest_gpos.x, 0, self.dest_gpos.y))
        end

        self.waypoints = waypoints
        self.seg_lengths = {}
        self.cum_dist    = { 0 }
        local total_len = 0
        for i = 1, #self.waypoints - 1 do
            local d = self.waypoints[i]:distance_to(self.waypoints[i+1])
            self.seg_lengths[i] = d
            total_len = total_len + d
            self.cum_dist[i+1] = total_len
        end
        self.total_path_len = math.max(1, total_len)

        self.dot_gpositions = {}
        for i = 1, 12 do
            local frac = i / 13
            local pt, _ = self:GetPositionAlongRoute(frac)
            self.dot_gpositions[i] = { x = pt.x, y = pt.z }
        end

        local trek_span_uv = math.max(150, math.sqrt((self.dest_gpos.x - self.start_gpos.x)^2 + (self.dest_gpos.y - self.start_gpos.y)^2))
        self.base_scale = math.max(0.4, math.min(2.5, 600 / trek_span_uv))
    end

    -- Initial travel heading
    local cur_pos, heading = self:GetPositionAlongRoute(0.0)
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Initial viewport update
    self:UpdateViewport(cur_pos, 0.0)

    -- Configure HUD labels
    local display_dest = self.dest_level_name or self.level_name
    if self.txt_title then
        self.txt_title:SetText(string.format("EXPEDITION: %s", string.upper(display_dest)))
    end
    if self.txt_route_info then
        self.txt_route_info:SetText(string.format("ROUTE TREK: %dm | SAFE STRIDE MODE ACTIVE", math.floor(self.travel_dist)))
    end
    if self.txt_pace then
        self.txt_pace:SetText("SLOW PACE / SCANNING")
    end

    -- Initial reconnaissance log entries
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)
    self:AddLog(string.format("%s - Route plotted: heading towards destination beacon.", t_str))
    self:AddLog(string.format("%s - ALife Threat Radar scanning road ahead (100m radius)...", t_str))
end

-- Interpolate traveler coordinate along waypoints polyline using Catmull-Rom cubic splines
function UIRoadAheadTravelMap:GetPositionAlongRoute(ratio)
    local n_pts = (self.waypoints and #self.waypoints) or 0
    if n_pts == 0 then
        return vector():set(0, 0, 0), 0, self.level_name
    end
    if n_pts == 1 or ratio <= 0 then
        local p = self.waypoints[1]
        local heading = 0
        if n_pts > 1 then
            local next_p = self.waypoints[2]
            heading = math.atan2(next_p.x - p.x, -(next_p.z - p.z))
        end
        local lvl = (self.route_node_info and self.route_node_info[1]) or self.level_name
        return vector():set(p.x, p.y, p.z), heading, lvl
    end
    if ratio >= 1.0 then
        local p = self.waypoints[n_pts]
        local prev_p = self.waypoints[math.max(1, n_pts - 1)]
        local heading = math.atan2(p.x - prev_p.x, -(p.z - prev_p.z))
        local lvl = (self.route_node_info and self.route_node_info[n_pts]) or self.dest_level_name or self.level_name
        return vector():set(p.x, p.y, p.z), heading, lvl
    end

    local target_dist = ratio * self.total_path_len
    for i = 1, n_pts - 1 do
        local seg_start_d = self.cum_dist[i]
        local seg_end_d   = self.cum_dist[i+1]
        if target_dist >= seg_start_d and target_dist <= seg_end_d then
            local seg_len = math.max(0.001, self.seg_lengths[i])
            local t = math.max(0.0, math.min(1.0, (target_dist - seg_start_d) / seg_len))
            local p0 = self.waypoints[math.max(1, i - 1)]
            local p1 = self.waypoints[i]
            local p2 = self.waypoints[i + 1]
            local p3 = self.waypoints[math.min(n_pts, i + 2)]
            local pt, heading = catmull_rom_spline(p0, p1, p2, p3, t)
            local lvl = (self.route_node_info and (t < 0.5 and self.route_node_info[i] or self.route_node_info[i+1])) or self.level_name
            return pt, heading, lvl
        end
    end

    local last = self.waypoints[n_pts]
    local prev = self.waypoints[math.max(1, n_pts - 1)]
    local heading = math.atan2(last.x - prev.x, -(last.z - prev.z))
    local lvl = (self.route_node_info and self.route_node_info[n_pts]) or self.dest_level_name or self.level_name
    return vector():set(last.x, last.y, last.z), heading, lvl
end

-- Unified cartographic viewport projection engine
function UIRoadAheadTravelMap:UpdateViewport(cur_pos, ratio)
    cur_pos = cur_pos or (self.waypoints and self.waypoints[1]) or vector():set(0, 0, 0)
    ratio   = ratio or 0.0

    local FW = 1024
    local FH = 768
    local CX = 512
    local CY = 384

    -- 1. Pawn Marker dead center at (CX - 14, CY - 14)
    self.pawn_marker:SetWndPos(vector2():set(CX - 14, CY - 14))
    self.pawn_marker:Show(true)

    if not self.is_transition then
        -- LOCAL EXPEDITION IN PHYSICAL WORLD METERS
        local scale = (self.base_scale or 1.0) * (self.user_zoom or 1.0)

        local cur_x, cur_z = to_coords(cur_pos)

        -- 2. Departure Origin Marker
        if self.start_pos then
            local sx0, sz0 = to_coords(self.start_pos)
            local sx = CX + (sx0 - cur_x) * scale
            local sy = CY - (sz0 - cur_z) * scale
            if sx >= -24 and sx <= FW + 24 and sy >= -24 and sy <= FH + 24 then
                self.start_marker:SetWndPos(vector2():set(sx - 12, sy - 12))
                self.start_marker:Show(true)
            else
                self.start_marker:Show(false)
            end
        else
            self.start_marker:Show(false)
        end

        -- 3. Target Destination Marker
        if self.dest_pos then
            local dx0, dz0 = to_coords(self.dest_pos)
            local dx = CX + (dx0 - cur_x) * scale
            local dy = CY - (dz0 - cur_z) * scale
            if dx >= -28 and dx <= FW + 28 and dy >= -28 and dy <= FH + 28 then
                self.dest_marker:SetWndPos(vector2():set(dx - 14, dy - 14))
                self.dest_marker:Show(true)
            else
                self.dest_marker:Show(false)
            end
        else
            self.dest_marker:Show(false)
        end

        -- 4. Trail Dots (1..12)
        for i = 1, 12 do
            local p = self.dot_positions and self.dot_positions[i]
            if p then
                local px0, pz0 = to_coords(p)
                local px = CX + (px0 - cur_x) * scale
                local py = CY - (pz0 - cur_z) * scale
                if px >= -8 and px <= FW + 8 and py >= -8 and py <= FH + 8 then
                    self.trail_dots[i]:SetWndPos(vector2():set(px - 4, py - 4))
                    self.trail_dots[i]:Show(true)
                else
                    self.trail_dots[i]:Show(false)
                end
            else
                self.trail_dots[i]:Show(false)
            end
        end

        -- 5. Level Map Canvas (Fluid Jitter-free Bilinear Rendering)
        local bounds = self.bounds or get_level_bounds(self.level_name)
        if bounds and self.map_canvas then
            local tex_id = LEVEL_MAP_TEXTURES[self.level_name] or LEVEL_MAP_TEXTURES["escape"]
            local ts = MAP_TEXTURE_SIZES[tex_id] or { w = 2048, h = 2048 }
            local tw, th = ts.w, ts.h

            local left   = CX + (bounds.x1 - cur_x) * scale
            local right  = CX + (bounds.x2 - cur_x) * scale
            local top    = CY - (bounds.z2 - cur_z) * scale
            local bottom = CY - (bounds.z1 - cur_z) * scale
            local scr_w  = math.max(1, right - left)
            local scr_h  = math.max(1, bottom - top)

            if left <= 0 and top <= 0 and right >= FW and bottom >= FH then
                -- Canvas covers full viewport: lock quad to screen (0, 0, FW, FH) for 100% fluid bilinear scrolling!
                self.map_canvas:SetWndPos(vector2():set(0, 0))
                self.map_canvas:SetWndSize(vector2():set(FW, FH))

                local u1 = ((0 - left) / scr_w) * tw
                local v1 = ((0 - top) / scr_h) * th
                local u2 = ((FW - left) / scr_w) * tw
                local v2 = ((FH - top) / scr_h) * th

                self.map_canvas:SetTextureRect(Frect():set(u1, v1, u2, v2))
                self.map_canvas:Show(true)
                if self.bg_map_canvas then self.bg_map_canvas:Show(false) end
            else
                -- Zoomed out or level edge visible: render partial quad and background
                local vx1 = math.max(0, left)
                local vy1 = math.max(0, top)
                local vx2 = math.min(FW, right)
                local vy2 = math.min(FH, bottom)

                if vx2 > vx1 and vy2 > vy1 then
                    local u1 = ((vx1 - left) / scr_w) * tw
                    local v1 = ((vy1 - top) / scr_h) * th
                    local u2 = ((vx2 - left) / scr_w) * tw
                    local v2 = ((vy2 - top) / scr_h) * th

                    self.map_canvas:SetWndPos(vector2():set(vx1, vy1))
                    self.map_canvas:SetWndSize(vector2():set(vx2 - vx1, vy2 - vy1))
                    self.map_canvas:SetTextureRect(Frect():set(u1, v1, u2, v2))
                    self.map_canvas:Show(true)
                else
                    self.map_canvas:Show(false)
                end

                if self.bg_map_canvas then
                    self.bg_map_canvas:SetWndPos(vector2():set(0, 0))
                    self.bg_map_canvas:SetWndSize(vector2():set(FW, FH))
                    self.bg_map_canvas:SetTextureRect(Frect():set(0, 0, 4096, 8192))
                    self.bg_map_canvas:Show(true)
                end
            end
        end
    else
        -- CROSS-ZONE EXPEDITION (GLOBAL ZONE VIEW)
        if self.map_canvas then self.map_canvas:Show(false) end

        local cur_u = cur_pos.x
        local cur_v = cur_pos.z
        local g_zoom = math.max(0.28, (self.base_scale or 1.0) * (self.user_zoom or 1.0))

        local span_u = FW / g_zoom
        local span_v = FH / g_zoom

        if span_u > 4096 then
            span_u = 4096
            g_zoom = FW / 4096
            span_v = FH / g_zoom
        end
        if span_v > 8192 then
            span_v = 8192
            g_zoom = FH / 8192
            span_u = FW / g_zoom
        end

        local u1 = cur_u - span_u * 0.5
        local v1 = cur_v - span_v * 0.5

        if u1 < 0 then
            u1 = 0
        elseif u1 + span_u > 4096 then
            u1 = 4096 - span_u
        end

        if v1 < 0 then
            v1 = 0
        elseif v1 + span_v > 8192 then
            v1 = 8192 - span_v
        end

        local u2 = u1 + span_u
        local v2 = v1 + span_v

        self.bg_map_canvas:SetWndPos(vector2():set(0, 0))
        self.bg_map_canvas:SetWndSize(vector2():set(FW, FH))
        self.bg_map_canvas:SetTextureRect(Frect():set(u1, v1, u2, v2))
        self.bg_map_canvas:Show(true)

        -- Pawn marker position in screen space
        local pawn_sx = (cur_u - u1) * g_zoom
        local pawn_sy = (cur_v - v1) * g_zoom
        self.pawn_marker:SetWndPos(vector2():set(pawn_sx - 14, pawn_sy - 14))
        self.pawn_marker:Show(true)

        -- Departure Origin Marker
        if self.start_gpos then
            local sx = (self.start_gpos.x - u1) * g_zoom
            local sy = (self.start_gpos.y - v1) * g_zoom
            if sx >= -24 and sx <= FW + 24 and sy >= -24 and sy <= FH + 24 then
                self.start_marker:SetWndPos(vector2():set(sx - 12, sy - 12))
                self.start_marker:Show(true)
            else
                self.start_marker:Show(false)
            end
        else
            self.start_marker:Show(false)
        end

        -- Target Destination Marker
        if self.dest_gpos then
            local dx = (self.dest_gpos.x - u1) * g_zoom
            local dy = (self.dest_gpos.y - v1) * g_zoom
            if dx >= -28 and dx <= FW + 28 and dy >= -28 and dy <= FH + 28 then
                self.dest_marker:SetWndPos(vector2():set(dx - 14, dy - 14))
                self.dest_marker:Show(true)
            else
                self.dest_marker:Show(false)
            end
        else
            self.dest_marker:Show(false)
        end

        -- Trail dots
        for i = 1, 12 do
            local gp = self.dot_gpositions and self.dot_gpositions[i]
            if gp then
                local px = (gp.x - u1) * g_zoom
                local py = (gp.y - v1) * g_zoom
                if px >= -8 and px <= FW + 8 and py >= -8 and py <= FH + 8 then
                    self.trail_dots[i]:SetWndPos(vector2():set(px - 4, py - 4))
                    self.trail_dots[i]:Show(true)
                else
                    self.trail_dots[i]:Show(false)
                end
            else
                self.trail_dots[i]:Show(false)
            end
        end
    end
end

function UIRoadAheadTravelMap:Update()
    CUIScriptWnd.Update(self)

    local tlra_core = zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra
    if not tlra_core then return end

    if not tlra_core.is_traveling and not self.encounter_active then
        self:Close()
        return
    end

    if self.travel_paused then return end

    local ok, err = pcall(self.ProcessUpdate, self, tlra_core)
    if not ok then
        tlra_log("ERROR in UIRoadAheadTravelMap:Update: %s", tostring(err))
    end
end

function UIRoadAheadTravelMap:ProcessUpdate(tlra_core)
    local current_dist = tlra_core.current_dist or 0
    local total_dist   = math.max(1, tlra_core.travel_dist or self.travel_dist or 1)
    local ratio        = math.min(current_dist / total_dist, 1.0)

    -- Interpolate physical traveler position along road waypoints
    local cur_pos, heading, cur_lvl = self:GetPositionAlongRoute(ratio)
    self.current_route_level = cur_lvl
    if self.is_transition and cur_lvl and self.txt_title then
        self.txt_title:SetText(string.format("EXPEDITION: %s", string.upper(cur_lvl)))
    end

    -- Auto-center map viewport on interpolated position
    self:UpdateViewport(cur_pos, ratio)

    -- Smoothly rotate pawn heading
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Update progress text & gauge (250px total track width)
    local pct = math.floor(ratio * 100)
    self.txt_progress:SetText(string.format("%d%% (%dm / %dm)", pct, math.floor(current_dist), math.floor(total_dist)))
    self.progress_fill:SetWndSize(vector2():set(math.floor(250 * ratio), 12))

    -- Update accelerated world clock
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local tf = math.floor(level.get_time_factor() + 0.5)
    self.txt_clock:SetText(string.format("%02d:%02d [%dx SPEED]", h, m, tf))

    -- Update weather and environmental concealment rating
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local env_desc = "Clear Skies"
    local w_lower = string.lower(weather_name)
    if string.find(w_lower, "storm") or string.find(w_lower, "thunder") then
        env_desc = "Heavy Storm (Cover +15%)"
    elseif string.find(w_lower, "rain") or string.find(w_lower, "fog") then
        env_desc = "Rain / Fog (Cover +10%)"
    elseif string.find(w_lower, "cloud") then
        env_desc = "Overcast (Cover +5%)"
    elseif h < 5 or h >= 22 then
        env_desc = "Night Darkness (Cover +20%)"
    end
    if self.txt_env then self.txt_env:SetText("WEATHER: " .. string.upper(env_desc)) end

    local threat_desc = "LOW (Clear Route)"
    if self.encounter_active then
        threat_desc = "CRITICAL (Hostile Ambush!)"
    elseif tlra_core.nearby_threats and #tlra_core.nearby_threats > 0 then
        threat_desc = "HIGH (ALife Activity)"
    end
    if self.txt_threat_hud then self.txt_threat_hud:SetText("THREAT RISK: " .. threat_desc) end

    -- Update survival metabolism
    self:UpdateSurvivalVitals()

    -- Ambient road reconnaissance log progression
    local step = math.floor(ratio * 10)
    if step > self.last_log_step then
        self.last_log_step = step
        local log_pool = {
            "Passing roadside landmarks... Maintaining low profile.",
            "Terrain clear of anomalies. Stamina holding stable.",
            "ALife Threat Radar scanning road ahead (100m radius)...",
            "Checking geiger counter... Radiation levels nominal.",
            "Weather clear. Steady walking rhythm established.",
            "Moving along road corridor at steady walking pace.",
            "Observation: wind picking up, distant bird cries heard.",
            "Maintaining vigilant watch on tree line and ridges.",
        }
        local pick = log_pool[math.random(#log_pool)]
        local t_str = string.format("%02d:%02d", h, m)
        self:AddLog(string.format("%s - %s", t_str, pick))
    end
end

-- Refresh survival metabolism gauges
function UIRoadAheadTravelMap:UpdateSurvivalVitals()
    local actor = db.actor
    if not actor then return end

    local satiety = 1.0
    pcall(function()
        if actor.satiety then satiety = math.max(0.0, math.min(1.0, actor.satiety)) end
    end)
    local cal = math.floor(satiety * 2500)
    if self.txt_calories then self.txt_calories:SetText(string.format("CALORIES: %d kcal (-14 kcal/min)", cal)) end

    local thirst = 1.0
    pcall(function()
        if actor_status_thirst and actor_status_thirst.get_water then
            thirst = math.max(0.0, math.min(1.0, actor_status_thirst.get_water()))
        end
    end)
    if self.txt_hydration then self.txt_hydration:SetText(string.format("HYDRATION: %d%%", math.floor(thirst * 100))) end

    local stam = 1.0
    pcall(function()
        if actor.power then stam = math.max(0.0, math.min(1.0, actor.power)) end
    end)
    if self.txt_stamina then self.txt_stamina:SetText(string.format("STAMINA: %d%%", math.floor(stam * 100))) end

    local weight = 35.0
    pcall(function()
        if actor.get_total_weight then
            weight = math.floor(actor:get_total_weight() * 10) / 10
        end
    end)

    local max_w = 60.0
    pcall(function()
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.get_real_max_weight then
            max_w = zzzz_the_long_road_ahead.get_real_max_weight()
        elseif actor.get_actor_max_walk_weight then
            max_w = actor:get_actor_max_walk_weight()
        elseif actor.get_actor_max_weight then
            max_w = actor:get_actor_max_weight()
        end
    end)
    max_w = math.floor(max_w * 10) / 10

    if self.txt_encumbrance then self.txt_encumbrance:SetText(string.format("PACK: %.1f kg / %.0f kg [Stride: 3.4 m/s]", weight, max_w)) end

    local rad = 0.0
    pcall(function()
        if actor.radiation then rad = math.max(0.0, actor.radiation * 0.1) end
    end)
    if self.txt_rad then self.txt_rad:SetText(string.format("RADIATION: %.2f mSv", rad)) end

    local psy = 1.0
    pcall(function()
        if actor.psy_health then psy = math.max(0.0, math.min(1.0, actor.psy_health)) end
    end)
    if self.psy_fill then
        self.psy_fill:SetWndSize(vector2():set(math.floor(83 * psy), 10))
    end
end

-- Add message to scrolling expedition journal
function UIRoadAheadTravelMap:AddLog(msg)
    table.insert(self.log_history, msg)
    if #self.log_history > 5 then
        table.remove(self.log_history, 1)
    end
    for i = 1, 5 do
        local entry = self.log_history[i] or ""
        if self.txt_logs and self.txt_logs[i] then
            self.txt_logs[i]:SetText(entry)
        end
    end
end

-- ===================================================================
-- INTERACTIVE ROAD ENCOUNTER LOGIC (Kingdom Come: Deliverance Style)
-- ===================================================================
function UIRoadAheadTravelMap:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    self.travel_paused = true
    self.encounter_active = true
    self.on_evade_cb = on_evade_cb
    self.on_engage_cb = on_engage_cb
    self.evasion_chance = evasion_chance or 50

    if self.snd_alarm then
        self.snd_alarm:play(db.actor, 0, sound_object.s2d)
    end

    self.txt_threat_title:SetText("HOSTILE CONTACT DETECTED ON ROAD!")
    self.txt_threat_desc:SetText(string.format("Intercepting ALife Force: %s", threat_name or "Unknown Hostile Squad"))
    self.txt_threat_range:SetText(string.format("Estimated Proximity: %dm Ahead", math.floor(threat_dist or 80)))

    local h = level.get_time_hours()
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local mods = {}
    if h < 5 or h >= 22 then table.insert(mods, "Night Darkness (+20%)") end
    if string.find(string.lower(weather_name), "rain") or string.find(string.lower(weather_name), "fog") then
        table.insert(mods, "Storm/Fog Cover (+10%)")
    end
    local mod_text = #mods > 0 and table.concat(mods, " + ") or "Standard Visibility (No modifiers)"
    self.txt_threat_stealth_info:SetText("Tactical Cover: " .. mod_text)

    self.txt_evasion_odds:SetText(string.format("STEALTH EVASION: %d%%", self.evasion_chance))
    self:Enable(true)
    self:Show(true)
    self.btn_attempt_evade:Enable(true)
    self.btn_drop_and_fight:Enable(true)
    self.encounter_modal:Show(true)

    local t_str = string.format("%02d:%02d", h, level.get_time_minutes())
    self:AddLog(string.format("%s - [ALERT] %s spotted ahead (%dm)!", t_str, threat_name or "Hostile", math.floor(threat_dist or 80)))
end

function UIRoadAheadTravelMap:OnAttemptEvade()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local roll = math.random(1, 100)
    local success = roll <= self.evasion_chance

    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)

    if success then
        if self.snd_evade then self.snd_evade:play(db.actor, 0, sound_object.s2d) end
        self:AddLog(string.format("%s - [SUCCESS] Slipped past hostiles undetected!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self.travel_paused = false
        if self.on_evade_cb then
            self.on_evade_cb(true)
        end
    else
        self:AddLog(string.format("%s - [FAILED] Ambush! Enemies spotted you!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self:Close()
        if self.on_evade_cb then
            self.on_evade_cb(false)
        end
    end
end

function UIRoadAheadTravelMap:OnDropAndFight()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)
    self:AddLog(string.format("%s - Dropping out to engage hostile contact!", t_str))

    self.encounter_modal:Show(false)
    self.encounter_active = false
    self:Close()

    if self.on_engage_cb then
        self.on_engage_cb()
    end
end

function UIRoadAheadTravelMap:OnHaltClicked()
    self:Close()
    if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.abort_travel_safe then
        zzzz_the_long_road_ahead.abort_travel_safe()
    end
end

function UIRoadAheadTravelMap:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)

    -- Mouse Wheel Zooming via DIK key codes (237 = Wheel Up, 236 = Wheel Down)
    local MOUSE_WHEEL_UP   = (DIK_keys and (DIK_keys.MOUSE_WHEEL_UP or DIK_keys.DIK_MOUSEWHEELUP)) or 237
    local MOUSE_WHEEL_DOWN = (DIK_keys and (DIK_keys.MOUSE_WHEEL_DOWN or DIK_keys.DIK_MOUSEWHEELDOWN)) or 236

    if dik == MOUSE_WHEEL_UP then
        self:AdjustZoom(1)
        return true
    elseif dik == MOUSE_WHEEL_DOWN then
        self:AdjustZoom(-1)
        return true
    end

    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            if self.encounter_active then
                self:OnDropAndFight()
            else
                self:OnHaltClicked()
            end
            return true
        elseif self.encounter_active then
            if dik == DIK_keys.DIK_1 or dik == DIK_keys.DIK_E then
                self:OnAttemptEvade()
                return true
            elseif dik == DIK_keys.DIK_2 or dik == DIK_keys.DIK_F or dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_SPACE then
                self:OnDropAndFight()
                return true
            end
        end
    end

    return res
end

function UIRoadAheadTravelMap:Close()
    self.travel_paused = true
    pcall(function() self:HideDialog() end)
    self:Show(false)
    Unregister_UI("UIRoadAheadTravelMap")
    pcall(function()
        level.remove_pp_effector(8877)
        if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
    end)
    GUI = nil
end

-- ===================================================================
-- GLOBAL LIFECYCLE HOOKS
-- ===================================================================
function is_open()
    return GUI ~= nil and GUI:IsShown()
end

function trigger_encounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    if GUI and GUI:IsShown() then
        GUI:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    end
end

function show_map(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    if not GUI then
        GUI = UIRoadAheadTravelMap()
    end
    GUI:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    GUI:ShowDialog(true)
    Register_UI("UIRoadAheadTravelMap", "ui_sleep_dialog")
    return GUI
end

-- ===================================================================
-- ENGINE MOUSE WHEEL CALLBACK
-- ===================================================================
function on_mouse_wheel(dir, flags)
    if GUI and GUI:IsShown() and not GUI.encounter_active then
        local d = tonumber(dir)
        if d == 1 or dir == true then
            GUI:AdjustZoom(1)
        elseif d == 0 or d == -1 or dir == false then
            GUI:AdjustZoom(-1)
        end
        if flags then flags.ret_value = false end
    end
end

function on_game_start()
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
end

function close_map()
    if GUI then
        pcall(function() GUI:HideDialog() end)
        GUI:Close()
    else
        pcall(function()
            level.remove_pp_effector(8877)
            if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
        end)
    end
    GUI = nil
end
