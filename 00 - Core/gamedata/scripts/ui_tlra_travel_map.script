    self:AddCallback("btn_attempt_evade", ui_events.BUTTON_CLICKED, self.OnAttemptEvade, self)
    self:AddCallback("btn_drop_and_fight", ui_events.BUTTON_CLICKED, self.OnDropAndFight, self)
end

local function to_coords(p)
    if not p then return 0.0, 0.0 end
    local ok_x, x = pcall(function() return p.x end)
    local ok_z, z = pcall(function() return p.z end)
    if ok_x and x and ok_z and z then
        return x, z
    end
    local ok_y, y = pcall(function() return p.y end)
    if ok_x and x and ok_y and y and (not ok_z or not z) then
        return x, y
    end
    if type(p) == "table" then
        local tx = p.x or p[1] or 0.0
        local tz = p.z or p[3] or p.y or p[2] or 0.0
        return tx, tz
    end
    return 0.0, 0.0
end

local function to_vector(p)
    if not p then return vector():set(0, 0, 0) end
    local ok_x, x = pcall(function() return p.x end)
    local ok_y, y = pcall(function() return p.y end)
    local ok_z, z = pcall(function() return p.z end)
    if ok_x and x and ok_y and y and ok_z and z then
        return vector():set(x, y, z)
    end
    local tx = (type(p) == "table" and (p.x or p[1])) or 0.0
    local ty = (type(p) == "table" and (p.y or p[2])) or 0.0
    local tz = (type(p) == "table" and (p.z or p[3])) or 0.0
    return vector():set(tx, ty, tz)
end

-- Setup and launch expedition display with all map textures loaded simultaneously
local function catmull_rom_spline(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t

    local x0, z0 = to_coords(p0)
    local x1, z1 = to_coords(p1)
    local x2, z2 = to_coords(p2)
    local x3, z3 = to_coords(p3)

    local x = 0.5 * ((2 * x1) +
                     (-x0 + x2) * t +
                     (2 * x0 - 5 * x1 + 4 * x2 - x3) * t2 +
                     (-x0 + 3 * x1 - 3 * x2 + x3) * t3)
    local z = 0.5 * ((2 * z1) +
                     (-z0 + z2) * t +
                     (2 * z0 - 5 * z1 + 4 * z2 - z3) * t2 +
                     (-z0 + 3 * z1 - 3 * z2 + z3) * t3)

    local dx = 0.5 * ((-x0 + x2) +
                      2 * (2 * x0 - 5 * x1 + 4 * x2 - x3) * t +
                      3 * (-x0 + 3 * x1 - 3 * x2 + x3) * t2)
    local dz = 0.5 * ((-z0 + z2) +
                      2 * (2 * z0 - 5 * z1 + 4 * z2 - z3) * t +
                      3 * (-z0 + 3 * z1 - 3 * z2 + z3) * t2)

    local heading = math.atan2(dx, -dz)
    return vector():set(x, 0, z), heading
end

-- Setup and launch expedition display with true physical scale and multi-level cartography
function UIRoadAheadTravelMap:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    self.start_pos       = to_vector(start_pos or (db.actor and db.actor:position()))
    self.dest_pos        = to_vector(dest_pos or self.start_pos)
    self.level_name      = level_name or (level and level.name and level.name()) or "escape"
    self.dest_level_name = dest_level_name or self.level_name
    self.is_transition   = is_transition or false
    self.travel_dist     = travel_dist or math.max(1, self.start_pos:distance_to(self.dest_pos))
    self.travel_paused   = false
    self.encounter_active = false
    self.last_log_step   = 0
    self.log_history     = {}
    self.user_zoom       = 1.0

    -- Load geographic map coordinates
    self.bounds          = get_level_bounds(self.level_name)
    self.global_canvas   = get_global_bounds()
    self.global_rect     = get_level_global_rect(self.level_name)

    -- Compute unified global UV positions for departure and destination
    self.start_gpos      = coord_to_global_uv(self.start_pos, self.level_name)
    self.dest_gpos       = coord_to_global_uv(self.dest_pos, self.dest_level_name or self.level_name)

    -- Ensure continuous global satellite map texture is initialized
    pcall(function()
        self.bg_map_canvas:InitTexture("tlra_map_global")
        self.bg_map_canvas:SetStretchTexture(true)
    end)
    if self.map_canvas then
        self.map_canvas:Show(false)
    end

    -- Lock pawn marker at dead center (512 - 32, 384 - 32) for 64x64 KCD miniature
    self.pawn_marker:SetWndPos(vector2():set(480, 352))
    self.pawn_marker:Show(true)

    local FW = 1024
    local FH = 768

    local waypoints = {}
    self.route_node_info = {}

    if not self.is_transition then
        -- Same-level local expedition: Map curated road path to unified global UV coordinates
        local road_path = nil
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.find_road_path then
            road_path = zzzz_the_long_road_ahead.find_road_path(self.start_pos, self.dest_pos, self.level_name)
        end

        if road_path and #road_path >= 2 then
            for idx, pt in ipairs(road_path) do
                local uv = coord_to_global_uv(pt, self.level_name)
                table.insert(waypoints, vector():set(uv.x, 0, uv.y))
                self.route_node_info[idx] = self.level_name
            end
        else
            table.insert(waypoints, vector():set(self.start_gpos.x, 0, self.start_gpos.y))
            self.route_node_info[1] = self.level_name

            local dot_positions = nil
            if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra then
                dot_positions = zzzz_the_long_road_ahead.tlra.dot_positions
            end
            if (not dot_positions or #dot_positions == 0) and zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.build_navmesh_dots then
                dot_positions = zzzz_the_long_road_ahead.build_navmesh_dots(self.start_pos, self.dest_pos, 12, self.level_name)
            end
            if dot_positions then
                for _, dp in ipairs(dot_positions) do
                    local uv = coord_to_global_uv(dp, self.level_name)
                    table.insert(waypoints, vector():set(uv.x, 0, uv.y))
                    self.route_node_info[#waypoints] = self.level_name
                end
            end
            table.insert(waypoints, vector():set(self.dest_gpos.x, 0, self.dest_gpos.y))
            self.route_node_info[#waypoints] = self.level_name
        end

        self.waypoints = waypoints
        self.seg_lengths = {}
        self.cum_dist    = { 0 }
        local total_len = 0
        for i = 1, #self.waypoints - 1 do
            local d = self.waypoints[i]:distance_to(self.waypoints[i+1])
            self.seg_lengths[i] = d
            total_len = total_len + d
            self.cum_dist[i+1] = total_len
        end
        self.total_path_len = math.max(1, total_len)
        self:BuildStampedFootsteps()

        local trek_span_uv = math.max(120, math.sqrt((self.dest_gpos.x - self.start_gpos.x)^2 + (self.dest_gpos.y - self.start_gpos.y)^2))
        self.base_scale = math.max(0.6, math.min(2.5, 520 / trek_span_uv))
    else
        -- Cross-zone expedition waypoints in unified global UV space
        local cross_route = nil
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.build_cross_zone_route then
            cross_route = zzzz_the_long_road_ahead.build_cross_zone_route(self.level_name, self.dest_level_name, self.start_pos, self.dest_pos)
        end

        if cross_route and #cross_route >= 2 then
            for idx, pt in ipairs(cross_route) do
                table.insert(waypoints, vector():set(pt.x, 0, pt.z))
                self.route_node_info[idx] = pt.lvl or self.level_name
            end
        else
            table.insert(waypoints, vector():set(self.start_gpos.x, 0, self.start_gpos.y))
            self.route_node_info[1] = self.level_name
            if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra and zzzz_the_long_road_ahead.tlra.first_door_pos then
                local door_uv = coord_to_global_uv(zzzz_the_long_road_ahead.tlra.first_door_pos, self.level_name)
                if door_uv then
                    table.insert(waypoints, vector():set(door_uv.x, 0, door_uv.y))
                    self.route_node_info[#waypoints] = self.level_name
                end
            end
            table.insert(waypoints, vector():set(self.dest_gpos.x, 0, self.dest_gpos.y))
            self.route_node_info[#waypoints] = self.dest_level_name or self.level_name
        end

        self.waypoints = waypoints
        self.seg_lengths = {}
        self.cum_dist    = { 0 }
        local total_len = 0
        for i = 1, #self.waypoints - 1 do
            local d = self.waypoints[i]:distance_to(self.waypoints[i+1])
            self.seg_lengths[i] = d
            total_len = total_len + d
            self.cum_dist[i+1] = total_len
        end
        self.total_path_len = math.max(1, total_len)
        self:BuildStampedFootsteps()

        local trek_span_uv = math.max(150, math.sqrt((self.dest_gpos.x - self.start_gpos.x)^2 + (self.dest_gpos.y - self.start_gpos.y)^2))
        self.base_scale = math.max(0.35, math.min(2.0, 600 / trek_span_uv))
    end

    -- Initial travel heading
    local cur_pos, heading = self:GetPositionAlongRoute(0.0)
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Initial viewport update
    self:UpdateViewport(cur_pos, 0.0)

    -- Configure HUD labels
    local display_dest = self.dest_level_name or self.level_name
    if self.txt_title then
        self.txt_title:SetText(string.format("EXPEDITION: %s", string.upper(display_dest)))
    end
    if self.txt_route_info then
        self.txt_route_info:SetText(string.format("ROUTE TREK: %dm | SAFE STRIDE MODE ACTIVE", math.floor(self.travel_dist)))
    end
    if self.txt_pace then
        self.txt_pace:SetText("SLOW PACE / SCANNING")
    end

    -- Initial ambient telemetry log entries
    local t_str = "08:00"
    pcall(function()
        local h = level.get_time_hours()
        local m = level.get_time_minutes()
        t_str = string.format("%02d:%02d", h, m)
    end)
    self:AddLog(string.format("%s - Route plotted: heading towards destination beacon.", t_str))
    self:AddLog(string.format("%s - ALife Threat Radar scanning road ahead (100m radius)...", t_str))
end

-- Interpolate traveler coordinate along waypoints polyline using Catmull-Rom cubic splines
function UIRoadAheadTravelMap:GetPositionAlongRoute(ratio)
    local n_pts = (self.waypoints and #self.waypoints) or 0
    if n_pts == 0 then
        return vector():set(0, 0, 0), 0, self.level_name
    end
    if n_pts == 1 or ratio <= 0 then
        local p = self.waypoints[1]
        local heading = 0
        if n_pts > 1 then
            local next_p = self.waypoints[2]
            heading = math.atan2(next_p.x - p.x, -(next_p.z - p.z))
        end
        local lvl = (self.route_node_info and self.route_node_info[1]) or self.level_name
        return vector():set(p.x, p.y, p.z), heading, lvl
    end
    if ratio >= 1.0 then
        local p = self.waypoints[n_pts]
        local prev_p = self.waypoints[math.max(1, n_pts - 1)]
        local heading = math.atan2(p.x - prev_p.x, -(p.z - prev_p.z))
        local lvl = (self.route_node_info and self.route_node_info[n_pts]) or self.dest_level_name or self.level_name
        return vector():set(p.x, p.y, p.z), heading, lvl
    end

    local target_dist = ratio * self.total_path_len
    for i = 1, n_pts - 1 do
        local seg_start_d = self.cum_dist[i]
        local seg_end_d   = self.cum_dist[i+1]
        if target_dist >= seg_start_d and target_dist <= seg_end_d then
            local seg_len = math.max(0.001, self.seg_lengths[i])
            local t = math.max(0.0, math.min(1.0, (target_dist - seg_start_d) / seg_len))
            local p0 = self.waypoints[math.max(1, i - 1)]
            local p1 = self.waypoints[i]
            local p2 = self.waypoints[i + 1]
            local p3 = self.waypoints[math.min(n_pts, i + 2)]
            local pt, heading = catmull_rom_spline(p0, p1, p2, p3, t)
            local lvl = (self.route_node_info and (t < 0.5 and self.route_node_info[i] or self.route_node_info[i+1])) or self.level_name
            return pt, heading, lvl
        end
    end

    local last = self.waypoints[n_pts]
    local prev = self.waypoints[math.max(1, n_pts - 1)]
    local heading = math.atan2(last.x - prev.x, -(last.z - prev.z))
    local lvl = (self.route_node_info and self.route_node_info[n_pts]) or self.dest_level_name or self.level_name
    return vector():set(last.x, last.y, last.z), heading, lvl
end

-- Pre-calculate and anchor authentic KCD stamped footsteps along the route polyline
function UIRoadAheadTravelMap:BuildStampedFootsteps()
    self.stamped_steps = {}
    local total_len = self.total_path_len or 1
    if total_len <= 15 then return end

    -- Stride distance between consecutive footprints in world map UV pixels (~18 uv units)
    local stride_uv = 18.0
    local cur_d = 20.0
    local step_idx = 1

    while cur_d < (total_len - 15.0) do
        local frac = cur_d / total_len
        local pt, heading = self:GetPositionAlongRoute(frac)

        -- Lateral shift: alternating right (+3.5 uv) and left (-3.5 uv)
        -- Heading 0 = North (dy < 0). Right perpendicular: (cos theta, sin theta)
        local is_right = (step_idx % 2 == 1)
        local r_norm_x = math.cos(heading)
        local r_norm_y = math.sin(heading)
        local lat_shift = is_right and 3.5 or -3.5

        local fx = pt.x + r_norm_x * lat_shift
        local fy = pt.z + r_norm_y * lat_shift

        table.insert(self.stamped_steps, {
            dist     = cur_d,
            u        = fx,
            v        = fy,
            heading  = heading,
            is_right = is_right
        })

        step_idx = step_idx + 1
        cur_d = cur_d + stride_uv
    end
end

-- Unified cartographic viewport projection engine
function UIRoadAheadTravelMap:UpdateViewport(cur_pos, ratio)
    cur_pos = cur_pos or (self.waypoints and self.waypoints[1]) or vector():set(2048, 0, 4096)
    ratio   = ratio or 0.0

    local FW = 1024
    local FH = 768
    local CX = 512
    local CY = 384

    if self.map_canvas then self.map_canvas:Show(false) end

    local cur_u = cur_pos.x
    local cur_v = cur_pos.z
    local g_zoom = math.max(0.28, (self.base_scale or 1.0) * (self.user_zoom or 1.0))

    local span_u = FW / g_zoom
    local span_v = FH / g_zoom

    if span_u > 4096 then
        span_u = 4096
        g_zoom = FW / 4096
        span_v = FH / g_zoom
    end
    if span_v > 8192 then
        span_v = 8192
        g_zoom = FH / 8192
        span_u = FW / g_zoom
    end

    local u1 = cur_u - span_u * 0.5
    local v1 = cur_v - span_v * 0.5

    if u1 < 0 then
        u1 = 0
    elseif u1 + span_u > 4096 then
        u1 = 4096 - span_u
    end

    if v1 < 0 then
        v1 = 0
    elseif v1 + span_v > 8192 then
        v1 = 8192 - span_v
    end

    local u2 = u1 + span_u
    local v2 = v1 + span_v

    self.bg_map_canvas:SetWndPos(vector2():set(0, 0))
    self.bg_map_canvas:SetWndSize(vector2():set(FW, FH))
    self.bg_map_canvas:SetTextureRect(Frect():set(u1, v1, u2, v2))
    self.bg_map_canvas:Show(true)

    -- Continuous Full-Screen Zone Master Satellite Cartography (4096x8192)
    -- Hides legacy/experimental cropped level overlays to guarantee 100% full, seamless, uncropped Zone coverage
    if self.level_canvases then
        for _, canvas in pairs(self.level_canvases) do
            canvas:Show(false)
        end
    end

    -- Pawn marker position in screen space (64x64 KCD Figurine)
    local pawn_sx = (cur_u - u1) * g_zoom
    local pawn_sy = (cur_v - v1) * g_zoom
    self.pawn_marker:SetWndPos(vector2():set(pawn_sx - 32, pawn_sy - 32))
    self.pawn_marker:Show(true)

    -- Departure Origin Marker
    if self.start_gpos then
        local sx = (self.start_gpos.x - u1) * g_zoom
        local sy = (self.start_gpos.y - v1) * g_zoom
        if sx >= -24 and sx <= FW + 24 and sy >= -24 and sy <= FH + 24 then
            self.start_marker:SetWndPos(vector2():set(sx - 12, sy - 12))
            self.start_marker:Show(true)
        else
            self.start_marker:Show(false)
        end
    else
        self.start_marker:Show(false)
    end

    -- Target Destination Marker
    if self.dest_gpos then
        local dx = (self.dest_gpos.x - u1) * g_zoom
        local dy = (self.dest_gpos.y - v1) * g_zoom
        if dx >= -28 and dx <= FW + 28 and dy >= -28 and dy <= FH + 28 then
            self.dest_marker:SetWndPos(vector2():set(dx - 14, dy - 14))
            self.dest_marker:Show(true)
        else
            self.dest_marker:Show(false)
        end
    else
        self.dest_marker:Show(false)
    end

    -- Authentic KCD Stamped Footprint Trail (permanently stamped to ground, strictly BEHIND pawn)
    local total_len = self.total_path_len or 1
    local cur_dist  = (ratio or 0.0) * total_len

    -- Pawn base clearance in UV: footsteps only appear behind the pawn figurine's base
    local pawn_base_clearance = 24.0 / math.max(0.01, g_zoom)
    local max_stamped_dist    = cur_dist - pawn_base_clearance

    local num_dots = (self.trail_dots and #self.trail_dots) or 20

    if self.stamped_steps and #self.stamped_steps > 0 then
        -- Find index of the most recent stamped step
        local last_stamped_idx = 0
        for idx, step in ipairs(self.stamped_steps) do
            if step.dist <= max_stamped_dist then
                last_stamped_idx = idx
            else
                break
            end
        end

        for i = 1, num_dots do
            local dot = self.trail_dots[i]
            if dot then
                local step_idx = last_stamped_idx - (i - 1)
                if step_idx >= 1 then
                    local step = self.stamped_steps[step_idx]
                    local fx = (step.u - u1) * g_zoom
                    local fy = (step.v - v1) * g_zoom

                    if fx >= -26 and fx <= FW + 26 and fy >= -26 and fy <= FH + 26 then
                        dot:SetWndPos(vector2():set(fx - 13, fy - 13))
                        pcall(function()
                            if dot.InitTexture then
                                dot:InitTexture(step.is_right and "tlra_trail_boot_r" or "tlra_trail_boot_l")
                            end
                            if dot.SetHeading then
                                dot:SetHeading(step.heading)
                            end
                        end)
                        dot:Show(true)
                    else
                        dot:Show(false)
                    end
                else
                    dot:Show(false)
                end
            end
        end
    else
        for i = 1, num_dots do
            if self.trail_dots[i] then self.trail_dots[i]:Show(false) end
        end
    end
end

function UIRoadAheadTravelMap:Update()
    CUIScriptWnd.Update(self)

    local tlra_core = zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra
    if not tlra_core then return end

    if not tlra_core.is_traveling and not self.encounter_active then
        self:Close()
        return
    end

    if self.travel_paused then return end

    local ok, err = pcall(self.ProcessUpdate, self, tlra_core)
    if not ok then
        tlra_log("ERROR in UIRoadAheadTravelMap:Update: %s", tostring(err))
    end
end

function UIRoadAheadTravelMap:ProcessUpdate(tlra_core)
    local current_dist = tlra_core.current_dist or 0
    local total_dist   = math.max(1, tlra_core.travel_dist or self.travel_dist or 1)
    local ratio        = math.min(current_dist / total_dist, 1.0)

    -- Interpolate physical traveler position along road waypoints
    local cur_pos, heading, cur_lvl = self:GetPositionAlongRoute(ratio)
    self.current_route_level = cur_lvl
    if cur_lvl and self.txt_title then
        self.txt_title:SetText(string.format("EXPEDITION: %s", string.upper(cur_lvl)))
    end

    -- Auto-center map viewport on interpolated position
    self:UpdateViewport(cur_pos, ratio)

    -- Smoothly rotate pawn heading
    pcall(function()
        if self.pawn_marker.SetHeading then
            self.pawn_marker:SetHeading(heading)
        end
    end)

    -- Update progress text & gauge (250px total track width)
    local pct = math.floor(ratio * 100)
    self.txt_progress:SetText(string.format("%d%% (%dm / %dm)", pct, math.floor(current_dist), math.floor(total_dist)))
    self.progress_fill:SetWndSize(vector2():set(math.floor(250 * ratio), 12))

    -- Update accelerated world clock
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local tf = math.floor(level.get_time_factor() + 0.5)
    self.txt_clock:SetText(string.format("%02d:%02d [%dx SPEED]", h, m, tf))

    -- Update weather and environmental concealment rating
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local env_desc = "Clear Skies"
    local w_lower = string.lower(weather_name)
    if string.find(w_lower, "storm") or string.find(w_lower, "thunder") then
        env_desc = "Heavy Storm (Cover +15%)"
    elseif string.find(w_lower, "rain") or string.find(w_lower, "fog") then
        env_desc = "Rain / Fog (Cover +10%)"
    elseif string.find(w_lower, "cloud") then
        env_desc = "Overcast (Cover +5%)"
    elseif h < 5 or h >= 22 then
        env_desc = "Night Darkness (Cover +20%)"
    end
    if self.txt_env then self.txt_env:SetText("WEATHER: " .. string.upper(env_desc)) end

    local threat_desc = "LOW (Clear Route)"
    if self.encounter_active then
        threat_desc = "CRITICAL (Hostile Ambush!)"
    elseif tlra_core.nearby_threats and #tlra_core.nearby_threats > 0 then
        threat_desc = "HIGH (ALife Activity)"
    end
    if self.txt_threat_hud then self.txt_threat_hud:SetText("THREAT RISK: " .. threat_desc) end

    -- Update survival metabolism
    self:UpdateSurvivalVitals()

    -- Ambient road reconnaissance log progression
    local step = math.floor(ratio * 10)
    if step > self.last_log_step then
        self.last_log_step = step
        local log_pool = {
            "Passing roadside landmarks... Maintaining low profile.",
            "Terrain clear of anomalies. Stamina holding stable.",
            "ALife Threat Radar scanning road ahead (100m radius)...",
            "Checking geiger counter... Radiation levels nominal.",
            "Weather clear. Steady walking rhythm established.",
            "Moving along road corridor at steady walking pace.",
            "Observation: wind picking up, distant bird cries heard.",
            "Maintaining vigilant watch on tree line and ridges.",
        }
        local pick = log_pool[math.random(#log_pool)]
        local t_str = string.format("%02d:%02d", h, m)
        self:AddLog(string.format("%s - %s", t_str, pick))
    end
end

-- Refresh survival metabolism gauges
function UIRoadAheadTravelMap:UpdateSurvivalVitals()
    local actor = db.actor
    if not actor then return end

    local satiety = 1.0
    pcall(function()
        if actor.satiety then satiety = math.max(0.0, math.min(1.0, actor.satiety)) end
    end)
    local cal = math.floor(satiety * 2500)
    if self.txt_calories then self.txt_calories:SetText(string.format("CALORIES: %d kcal (-14 kcal/min)", cal)) end

    local thirst = 1.0
    pcall(function()
        if actor_status_thirst and actor_status_thirst.get_water then
            thirst = math.max(0.0, math.min(1.0, actor_status_thirst.get_water()))
        end
    end)
    if self.txt_hydration then self.txt_hydration:SetText(string.format("HYDRATION: %d%%", math.floor(thirst * 100))) end

    local stam = 1.0
    pcall(function()
        if actor.power then stam = math.max(0.0, math.min(1.0, actor.power)) end
    end)
    if self.txt_stamina then self.txt_stamina:SetText(string.format("STAMINA: %d%%", math.floor(stam * 100))) end

    local weight = 35.0
    pcall(function()
        if actor.get_total_weight then
            weight = math.floor(actor:get_total_weight() * 10) / 10
        end
    end)

    local max_w = 60.0
    pcall(function()
        if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.get_real_max_weight then
            max_w = zzzz_the_long_road_ahead.get_real_max_weight()
        elseif actor.get_actor_max_walk_weight then
            max_w = actor:get_actor_max_walk_weight()
        elseif actor.get_actor_max_weight then
            max_w = actor:get_actor_max_weight()
        end
    end)
    max_w = math.floor(max_w * 10) / 10

    if self.txt_encumbrance then self.txt_encumbrance:SetText(string.format("PACK: %.1f kg / %.0f kg [Stride: 3.4 m/s]", weight, max_w)) end

    local rad = 0.0
    pcall(function()
        if actor.radiation then rad = math.max(0.0, actor.radiation * 0.1) end
    end)
    if self.txt_rad then self.txt_rad:SetText(string.format("RADIATION: %.2f mSv", rad)) end

    local psy = 1.0
    pcall(function()
        if actor.psy_health then psy = math.max(0.0, math.min(1.0, actor.psy_health)) end
    end)
    if self.psy_fill then
        self.psy_fill:SetWndSize(vector2():set(math.floor(83 * psy), 10))
    end
end

-- Add message to scrolling expedition journal
function UIRoadAheadTravelMap:AddLog(msg)
    table.insert(self.log_history, msg)
    if #self.log_history > 5 then
        table.remove(self.log_history, 1)
    end
    for i = 1, 5 do
        local entry = self.log_history[i] or ""
        if self.txt_logs and self.txt_logs[i] then
            self.txt_logs[i]:SetText(entry)
        end
    end
end

-- ===================================================================
-- INTERACTIVE ROAD ENCOUNTER LOGIC (Kingdom Come: Deliverance Style)
-- ===================================================================
function UIRoadAheadTravelMap:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    self.travel_paused = true
    self.encounter_active = true
    self.on_evade_cb = on_evade_cb
    self.on_engage_cb = on_engage_cb
    self.evasion_chance = evasion_chance or 50

    if self.snd_alarm then
        self.snd_alarm:play(db.actor, 0, sound_object.s2d)
    end

    self.txt_threat_title:SetText("HOSTILE CONTACT DETECTED ON ROAD!")
    self.txt_threat_desc:SetText(string.format("Intercepting ALife Force: %s", threat_name or "Unknown Hostile Squad"))
    self.txt_threat_range:SetText(string.format("Estimated Proximity: %dm Ahead", math.floor(threat_dist or 80)))

    local h = level.get_time_hours()
    local weather_name = (level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager():get_curr_weather()) or "clear"
    local mods = {}
    if h < 5 or h >= 22 then table.insert(mods, "Night Darkness (+20%)") end
    if string.find(string.lower(weather_name), "rain") or string.find(string.lower(weather_name), "fog") then
        table.insert(mods, "Storm/Fog Cover (+10%)")
    end
    local mod_text = #mods > 0 and table.concat(mods, " + ") or "Standard Visibility (No modifiers)"
    self.txt_threat_stealth_info:SetText("Tactical Cover: " .. mod_text)

    self.txt_evasion_odds:SetText(string.format("STEALTH EVASION: %d%%", self.evasion_chance))
    self:Enable(true)
    self:Show(true)
    self.btn_attempt_evade:Enable(true)
    self.btn_drop_and_fight:Enable(true)
    self.encounter_modal:Show(true)

    local t_str = string.format("%02d:%02d", h, level.get_time_minutes())
    self:AddLog(string.format("%s - [ALERT] %s spotted ahead (%dm)!", t_str, threat_name or "Hostile", math.floor(threat_dist or 80)))
end

function UIRoadAheadTravelMap:OnAttemptEvade()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local roll = math.random(1, 100)
    local success = roll <= self.evasion_chance

    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)

    if success then
        if self.snd_evade then self.snd_evade:play(db.actor, 0, sound_object.s2d) end
        self:AddLog(string.format("%s - [SUCCESS] Slipped past hostiles undetected!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self.travel_paused = false
        if self.on_evade_cb then
            self.on_evade_cb(true)
        end
    else
        self:AddLog(string.format("%s - [FAILED] Ambush! Enemies spotted you!", t_str))
        self.encounter_modal:Show(false)
        self.encounter_active = false
        self:Close()
        if self.on_evade_cb then
            self.on_evade_cb(false)
        end
    end
end

function UIRoadAheadTravelMap:OnDropAndFight()
    if self.snd_click then self.snd_click:play(db.actor, 0, sound_object.s2d) end
    local h = level.get_time_hours()
    local m = level.get_time_minutes()
    local t_str = string.format("%02d:%02d", h, m)
    self:AddLog(string.format("%s - Dropping out to engage hostile contact!", t_str))

    self.encounter_modal:Show(false)
    self.encounter_active = false
    self:Close()

    if self.on_engage_cb then
        self.on_engage_cb()
    end
end

function UIRoadAheadTravelMap:OnHaltClicked()
    self:Close()
    if zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.abort_travel_safe then
        zzzz_the_long_road_ahead.abort_travel_safe()
    end
end

function UIRoadAheadTravelMap:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)

    -- Mouse Wheel Zooming via DIK key codes (237 = Wheel Up, 236 = Wheel Down)
    local MOUSE_WHEEL_UP   = (DIK_keys and (DIK_keys.MOUSE_WHEEL_UP or DIK_keys.DIK_MOUSEWHEELUP)) or 237
    local MOUSE_WHEEL_DOWN = (DIK_keys and (DIK_keys.MOUSE_WHEEL_DOWN or DIK_keys.DIK_MOUSEWHEELDOWN)) or 236

    if dik == MOUSE_WHEEL_UP then
        self:AdjustZoom(1)
        return true
    elseif dik == MOUSE_WHEEL_DOWN then
        self:AdjustZoom(-1)
        return true
    end

    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            if self.encounter_active then
                self:OnDropAndFight()
            else
                self:OnHaltClicked()
            end
            return true
        elseif self.encounter_active then
            if dik == DIK_keys.DIK_1 or dik == DIK_keys.DIK_E then
                self:OnAttemptEvade()
                return true
            elseif dik == DIK_keys.DIK_2 or dik == DIK_keys.DIK_F or dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_SPACE then
                self:OnDropAndFight()
                return true
            end
        end
    end

    return res
end

function UIRoadAheadTravelMap:Close()
    self.travel_paused = true
    pcall(function()
        if self:IsShown() then
            self:HideDialog()
        end
    end)
    self:Show(false)
    Unregister_UI("UIRoadAheadTravelMap")
    pcall(function()
        level.remove_pp_effector(8877)
        if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
        if ActorMenu and ActorMenu.get_pda_menu then
            local pda = ActorMenu.get_pda_menu()
            if pda and pda:IsShown() then
                pda:HideDialog()
            end
        end
    end)
    GUI = nil
end

-- ===================================================================
-- GLOBAL LIFECYCLE HOOKS
-- ===================================================================
function is_open()
    return GUI ~= nil and GUI:IsShown()
end

function trigger_encounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    if GUI and GUI:IsShown() then
        GUI:PromptEncounter(threat_name, threat_dist, evasion_chance, on_evade_cb, on_engage_cb)
    end
end

function show_map(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    -- Cleanly close PDA if open so mouse state and dialog stack remain pristine
    pcall(function()
        if ActorMenu and ActorMenu.get_pda_menu then
            local pda = ActorMenu.get_pda_menu()
            if pda and pda:IsShown() then
                pda:HideDialog()
            end
        end
    end)

    if not GUI then
        GUI = UIRoadAheadTravelMap()
    end
    GUI:StartJourney(start_pos, dest_pos, level_name, is_transition, travel_dist, dest_level_name)
    GUI:ShowDialog(true)
    Register_UI("UIRoadAheadTravelMap", "ui_sleep_dialog")
    return GUI
end

-- ===================================================================
-- ENGINE MOUSE WHEEL CALLBACK
-- ===================================================================
function on_mouse_wheel(dir, flags)
    if GUI and GUI:IsShown() and not GUI.encounter_active then
        local d = tonumber(dir)
        if d == 1 or dir == true then
            GUI:AdjustZoom(1)
        elseif d == 0 or d == -1 or dir == false then
            GUI:AdjustZoom(-1)
        end
        if flags then flags.ret_value = false end
    end
end

function on_game_start()
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
end

function close_map()
    if GUI then
        pcall(function() GUI:HideDialog() end)
        GUI:Close()
    else
        pcall(function()
            level.remove_pp_effector(8877)
            if game and game.only_allow_movekeys then game.only_allow_movekeys(false) end
            if ActorMenu and ActorMenu.get_pda_menu then
                local pda = ActorMenu.get_pda_menu()
                if pda and pda:IsShown() then
                    pda:HideDialog()
                end
            end
        end)
    end
    GUI = nil
end
