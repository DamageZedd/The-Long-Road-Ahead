<w>
    <!-- =================================================================== -->
    <!-- THE LONG ROAD AHEAD: STALKER DIEGETIC EXPEDITION MAP INTERFACE      -->
    <!-- Resolution: 1024x768 (Full-screen authentic Zone cartography)       -->
    <!-- =================================================================== -->

    <!-- Fullscreen Pure Solid Pitch Black Backdrop (covers all aspect ratios) -->
    <background x="-1200" y="-600" width="3424" height="1968" stretch="1">
        <texture r="0" g="0" b="0">tlra_black_solid</texture>
    </background>

    <!-- =================================================================== -->
    <!-- FULLSCREEN MAP VIEWPORT FRAME (1024x768)                            -->
    <!-- =================================================================== -->
    <map_frame x="0" y="0" width="1024" height="768">
        <!-- Frame background plate -->
        <map_frame_bg x="0" y="0" width="1024" height="768" stretch="1">
            <texture r="10" g="12" b="14">tlra_white_solid</texture>
        </map_frame_bg>

        <!-- Base Layer: Continuous Zone Global Map -->
        <bg_map_canvas x="0" y="0" width="1024" height="768" stretch="1">
            <texture>tlra_map_global</texture>
        </bg_map_canvas>

        <!-- Detail Layer: High-Resolution Regional Level Map -->
        <map_canvas x="0" y="0" width="1024" height="768" stretch="1">
            <texture>tlra_map_global</texture>
        </map_canvas>

        <!-- Departure Origin Marker -->
        <start_marker x="0" y="0" width="24" height="24" stretch="1">
            <texture>ui_inGame2_PDA_icon_Place_to_rest</texture>
        </start_marker>

        <!-- Target Destination Marker (Glowing Amber Radiation Target Beacon) -->
        <dest_marker x="0" y="0" width="34" height="34" stretch="1">
            <texture>tlra_beacon_radiation</texture>
        </dest_marker>

        <!-- Dashed Yellow Road Breadcrumb Trail Dots (1..12) -->
        <trail_dot_1  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_1>
        <trail_dot_2  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_2>
        <trail_dot_3  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_3>
        <trail_dot_4  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_4>
        <trail_dot_5  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_5>
        <trail_dot_6  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_6>
        <trail_dot_7  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_7>
        <trail_dot_8  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_8>
        <trail_dot_9  x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_9>
        <trail_dot_10 x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_10>
        <trail_dot_11 x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_11>
        <trail_dot_12 x="-50" y="-50" width="16" height="6" stretch="1"><texture>tlra_trail_dash</texture></trail_dot_12>

        <!-- Stalker Silhouette Traveler Pawn: Anchored Dead-Center at (497, 364) -->
        <pawn_marker x="497" y="364" width="30" height="40" stretch="1">
            <texture>tlra_pawn_stalker</texture>
        </pawn_marker>
    </map_frame>

    <!-- =================================================================== -->
    <!-- TOP-LEFT: MILITARY FIELD DOSSIER / CLIPBOARD FOLDER TAB             -->
    <!-- =================================================================== -->
    <dossier_tab x="20" y="16" width="310" height="95">
        <dossier_bg x="0" y="0" width="310" height="95" stretch="1">
            <texture>tlra_dossier_tab</texture>
        </dossier_bg>
        <txt_title x="18" y="10" width="280" height="22">
            <text font="letterica18" r="35" g="40" b="30">EXPEDITION: THE ZONE</text>
        </txt_title>
        <txt_route x="18" y="34" width="280" height="16">
            <text font="letterica16" r="55" g="50" b="40">ROUTE TREK: 597m | SAFE STRIDE ACTIVE</text>
        </txt_route>
        <txt_pace x="18" y="52" width="280" height="16">
            <text font="letterica16" r="65" g="60" b="48">SLOW PACE / SCANNING</text>
        </txt_pace>
    </dossier_tab>

    <!-- =================================================================== -->
    <!-- TOP-CENTER: FLOATING TACTICAL CLOCK, WEATHER & ALIFE THREAT HUD     -->
    <!-- =================================================================== -->
    <top_center x="380" y="16" width="264" height="70">
        <txt_clock x="0" y="0" width="264" height="20">
            <text font="letterica18" r="245" g="240" b="220" align="c">[10x SPEED] 11:26</text>
        </txt_clock>
        <txt_weather x="0" y="20" width="264" height="18">
            <text font="letterica16" r="190" g="195" b="185" align="c">WEATHER: OVERCAST &amp; RAIN</text>
        </txt_weather>
        <txt_threat x="0" y="40" width="264" height="18">
            <text font="letterica16" r="255" g="95" b="65" align="c">THREAT RISK: HIGH (ALife Activity)</text>
        </txt_threat>
    </top_center>

    <!-- =================================================================== -->
    <!-- TOP-RIGHT: TRIP PROGRESS READOUT & ANTIQUE BRASS / THREAT GAUGES    -->
    <!-- =================================================================== -->
    <top_right x="710" y="18" width="290" height="65">
        <txt_progress x="0" y="0" width="270" height="18">
            <text font="letterica18" r="245" g="235" b="200" align="r">33% (197m / 597m)</text>
        </txt_progress>
        <progress_border x="10" y="22" width="262" height="14" stretch="1">
            <texture r="40" g="38" b="30">tlra_white_solid</texture>
        </progress_border>
        <progress_bg x="11" y="23" width="260" height="12" stretch="1">
            <texture r="20" g="20" b="18">tlra_white_solid</texture>
        </progress_bg>
        <progress_fill x="11" y="23" width="0" height="12" stretch="1">
            <texture>tlra_bar_brass</texture>
        </progress_fill>

        <threat_border x="10" y="38" width="262" height="12" stretch="1">
            <texture r="40" g="38" b="30">tlra_white_solid</texture>
        </threat_border>
        <threat_bg x="11" y="39" width="260" height="10" stretch="1">
            <texture r="20" g="20" b="18">tlra_white_solid</texture>
        </threat_bg>
        <threat_fill x="11" y="39" width="260" height="10" stretch="1">
            <texture>tlra_bar_gradient</texture>
        </threat_fill>
    </top_right>

    <!-- =================================================================== -->
    <!-- BOTTOM-LEFT: FLOATING SURVIVAL METABOLISM & PSY-HEALTH TELEMETRY    -->
    <!-- =================================================================== -->
    <vitals_panel x="20" y="620" width="280" height="130">
        <vitals_bg x="0" y="0" width="280" height="130" stretch="1">
            <texture r="16" g="20" b="22">tlra_white_solid</texture>
        </vitals_bg>
        <txt_calories x="12" y="10" width="160" height="18">
            <text font="letterica16" r="245" g="230" b="180">CALORIES: 2500 kcal (-14 kcal/min)</text>
        </txt_calories>
        <txt_hydration x="12" y="32" width="160" height="18">
            <text font="letterica16" r="130" g="205" b="250">HYDRATION: 99%</text>
        </txt_hydration>
        <txt_stamina x="12" y="54" width="160" height="18">
            <text font="letterica16" r="145" g="235" b="140">STAMINA: 99%</text>
        </txt_stamina>
        <txt_encumbrance x="12" y="76" width="160" height="18">
            <text font="letterica16" r="210" g="205" b="195">PACK: 34.9 kg / 60 kg [Stride: 3.4 m/s]</text>
        </txt_encumbrance>

        <txt_rad x="180" y="10" width="95" height="18">
            <text font="letterica16" r="245" g="195" b="80">RADIATION: 0.02 mSv</text>
        </txt_rad>
        <txt_psy x="180" y="54" width="95" height="18">
            <text font="letterica16" r="110" g="215" b="200">PSY-HEALTH</text>
        </txt_psy>
        <psy_border x="180" y="76" width="85" height="12" stretch="1">
            <texture r="30" g="50" b="50">tlra_white_solid</texture>
        </psy_border>
        <psy_fill x="181" y="77" width="83" height="10" stretch="1">
            <texture>tlra_bar_cyan</texture>
        </psy_fill>
    </vitals_panel>

    <!-- =================================================================== -->
    <!-- BOTTOM-CENTER: AUTHENTIC S.T.A.L.K.E.R. FIELD JOURNAL & LOG CARD    -->
    <!-- =================================================================== -->
    <journal_card x="315" y="560" width="450" height="190">
        <journal_bg x="0" y="0" width="450" height="190" stretch="1">
            <texture>tlra_field_journal</texture>
        </journal_bg>
        <txt_log_1 x="18" y="44" width="414" height="18">
            <text font="letterica16" r="230" g="225" b="200">11:26 - Crossing open terrain... Maintaining low profile.</text>
        </txt_log_1>
        <txt_log_2 x="18" y="66" width="414" height="18">
            <text font="letterica16" r="200" g="195" b="175">11:27 - Weather turning back... Wind picks up.</text>
        </txt_log_2>
        <txt_log_3 x="18" y="88" width="414" height="18">
            <text font="letterica16" r="170" g="165" b="150">11:28 - ALife Threat Radar scanning road ahead (100m radius).</text>
        </txt_log_3>
        <txt_log_4 x="18" y="110" width="414" height="18">
            <text font="letterica16" r="145" g="140" b="130">11:29 - DISTANT SHOTS HEARD in the direction of the Garbage checkpoint...</text>
        </txt_log_4>
        <txt_log_5 x="18" y="132" width="414" height="18">
            <text font="letterica16" r="120" g="115" b="110">11:30 - Route plotted: heading towards destination beacon.</text>
        </txt_log_5>
    </journal_card>

    <!-- =================================================================== -->
    <!-- BOTTOM-RIGHT: HEAVY RUSTED INDUSTRIAL METAL BUTTON                  -->
    <!-- =================================================================== -->
    <btn_halt x="815" y="655" width="180" height="65" stretch="1">
        <texture>tlra_btn_halt</texture>
        <text font="letterica18" r="220" g="220" b="210" align="c" vert_align="c">HALT [ESC]</text>
    </btn_halt>

    <!-- =================================================================== -->
    <!-- KINGDOM COME: DELIVERANCE THREAT ENCOUNTER MODAL CARD (Centered)    -->
    <!-- =================================================================== -->
    <encounter_modal x="182" y="154" width="660" height="410">
        <modal_bg x="0" y="0" width="660" height="410" stretch="1">
            <texture r="28" g="24" b="22">tlra_white_solid</texture>
        </modal_bg>
        <modal_top_line x="0" y="0" width="660" height="4" stretch="1">
            <texture r="235" g="60" b="45">tlra_white_solid</texture>
        </modal_top_line>
        <modal_bot_line x="0" y="406" width="660" height="4" stretch="1">
            <texture r="235" g="60" b="45">tlra_white_solid</texture>
        </modal_bot_line>
        <modal_left_line x="0" y="0" width="2" height="410" stretch="1">
            <texture r="235" g="60" b="45">tlra_white_solid</texture>
        </modal_left_line>
        <modal_right_line x="658" y="0" width="2" height="410" stretch="1">
            <texture r="235" g="60" b="45">tlra_white_solid</texture>
        </modal_right_line>

        <!-- Pulsing Threat Title -->
        <txt_threat_title x="20" y="22" width="620" height="30">
            <text font="graffiti22" r="255" g="65" b="50" align="c">⚠️ HOSTILE CONTACT DETECTED ON ROAD!</text>
        </txt_threat_title>

        <!-- Threat Description -->
        <txt_threat_desc x="30" y="70" width="600" height="24">
            <text font="letterica18" r="240" g="230" b="210" align="c">Unknown ALife Hostile Squad in proximity!</text>
        </txt_threat_desc>

        <!-- Threat Range & Tactical Environment Info -->
        <txt_threat_range x="30" y="100" width="600" height="20">
            <text font="letterica16" r="225" g="165" b="65" align="c">Estimated Distance: 75m</text>
        </txt_threat_range>
        <txt_threat_stealth_info x="30" y="126" width="600" height="20">
            <text font="letterica16" r="170" g="205" b="150" align="c">Stealth Modifiers: Night Darkness + Weather Concealment</text>
        </txt_threat_stealth_info>

        <!-- Center Evasion Gauge & Odds Readout -->
        <evasion_box x="155" y="165" width="350" height="64">
            <evasion_bg x="0" y="0" width="350" height="64" stretch="1">
                <texture r="40" g="34" b="30">tlra_white_solid</texture>
            </evasion_bg>
            <evasion_top_line x="0" y="0" width="350" height="2" stretch="1">
                <texture r="224" g="164" b="60">tlra_white_solid</texture>
            </evasion_top_line>
            <evasion_bot_line x="0" y="62" width="350" height="2" stretch="1">
                <texture r="224" g="164" b="60">tlra_white_solid</texture>
            </evasion_bot_line>
            <txt_evasion_odds x="10" y="14" width="330" height="36">
                <text font="graffiti22" r="235" g="175" b="65" align="c">STEALTH EVASION: 65%</text>
            </txt_evasion_odds>
        </evasion_box>

        <!-- Tactical Advice -->
        <txt_threat_advice x="30" y="248" width="600" height="20">
            <text font="letterica16" r="200" g="190" b="175" align="c">Attempt to sneak past undetected, or drop down and engage the enemy?</text>
        </txt_threat_advice>

        <!-- Action Choice Buttons -->
        <btn_attempt_evade x="50" y="295" width="260" height="52" stretch="1">
            <texture>ui_button_ordinary</texture>
            <text font="letterica18" align="c" vert_align="c">ATTEMPT EVASION</text>
        </btn_attempt_evade>

        <btn_drop_and_fight x="350" y="295" width="260" height="52" stretch="1">
            <texture>ui_button_ordinary</texture>
            <text font="letterica18" align="c" vert_align="c">DROP OUT &amp; FIGHT</text>
        </btn_drop_and_fight>
    </encounter_modal>
</w>
