-- Safe sound object loader
local function safe_sound(snd_path)
    local snd = nil
    pcall(function()
        snd = sound_object(snd_path)
    end)
    return snd
end

-- Safely retrieve game_maps_single.ltx ini interface
local function get_maps_ini()
    local ini = nil
    pcall(function() ini = game_ini() end)
    if not ini or not (ini.section_exist and ini:section_exist("global_map")) then
        pcall(function() ini = ini_file("game_maps_single.ltx") end)
    end
    return ini
end

-- Parse level bound_rect string into coordinate numbers
local function parse_bound_rect(raw)
    if type(raw) ~= "string" then return nil end
    local x1, z1, x2, z2 = string.match(raw, "^%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)%s*,%s*(-?[%d%.]+)")
    x1, z1, x2, z2 = tonumber(x1), tonumber(z1), tonumber(x2), tonumber(z2)
    if not (x1 and z1 and x2 and z2) then return nil end
    if x2 <= x1 or z2 <= z1 then return nil end
    return { x1 = x1, z1 = z1, x2 = x2, z2 = z2 }
end

-- Read level bounds from game configs or fallback table
function get_level_bounds(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local bounds = nil

    -- 1. Try reading bound_rect from maps ini
    local ini = get_maps_ini()
    local candidates = LEVEL_SECTION_NAMES[level_name] or { level_name }
    if ini then
        for _, sec in ipairs(candidates) do
            if ini:section_exist(sec) then
                local raw = ini:r_string_ex(sec, "bound_rect")
                if raw then
                    bounds = parse_bound_rect(raw)
                    if bounds then break end
                end
            end
        end
    end

    -- 2. Try reading from level.ltx
    if not bounds then
        pcall(function()
            local fs = getFS()
            if fs and fs.r_open then
                for _, sec in ipairs(candidates) do
                    local reader = fs:r_open("$game_levels$", sec .. "/level.ltx")
                    if reader then
                        local l_ini = ini_file(reader, "$game_levels$")
                        if l_ini and l_ini:section_exist("level_map") then
                            local raw = l_ini:r_string_ex("level_map", "bound_rect")
                            if raw then bounds = parse_bound_rect(raw) end
                        end
                        if bounds then break end
                    end
                end
            end
        end)
    end

    -- 3. Pre-cached fallback table
    if not bounds then
        for _, sec in ipairs(candidates) do
            if FALLBACK_LEVEL_BOUNDS[sec] then
                bounds = FALLBACK_LEVEL_BOUNDS[sec]
                break
            end
        end
    end

    return bounds
end

-- Read global Zone map canvas bounds
function get_global_bounds()
    local canvas = nil
    local ini = get_maps_ini()
    if ini and ini:section_exist("global_map") then
        local raw = ini:r_string_ex("global_map", "bound_rect")
        if raw then canvas = parse_bound_rect(raw) end
    end
    return canvas or { x1 = 0, z1 = 0, x2 = 1024, z2 = 2634 }
end

-- Read level placement rectangle on global Zone map
function get_level_global_rect(level_name)
    level_name = level_name or (level and level.name and level.name())
    if not level_name then return nil end
    local ini = get_maps_ini()
    if not ini then return nil end
    local candidates = LEVEL_SECTION_NAMES[level_name] or { level_name }
    for _, sec in ipairs(candidates) do
        if ini:section_exist(sec) then
            local raw = ini:r_string_ex(sec, "global_rect")
            if raw then
                local rect = parse_bound_rect(raw)
                if rect then return rect end
            end
        end
    end
    return nil
end

-- Convert level-local coordinates into 4096x8192 global Zone map pixel coordinates (u, v)
function coord_to_global_uv(pos, lvl_name)
    lvl_name = lvl_name or (level and level.name and level.name())
    local bounds = get_level_bounds(lvl_name)
    local rect   = get_level_global_rect(lvl_name)
    local canvas = get_global_bounds()
    if not (bounds and rect and canvas and pos) then
        return vector2():set(2048, 4096)
    end

    local g_scale_x = 4096 / math.max(1, canvas.x2 - canvas.x1)
    local g_scale_y = 8192 / math.max(1, canvas.z2 - canvas.z1)
    local orig_gx   = (rect.x1 - canvas.x1) * g_scale_x
    local orig_gy   = (rect.z1 - canvas.z1) * g_scale_y
    local rect_w_px = (rect.x2 - rect.x1) * g_scale_x
    local rect_h_px = (rect.z2 - rect.z1) * g_scale_y

    local g_ppm_x = rect_w_px / math.max(1, bounds.x2 - bounds.x1)
    local g_ppm_z = rect_h_px / math.max(1, bounds.z2 - bounds.z1)

    local u = orig_gx + (pos.x - bounds.x1) * g_ppm_x
    local v = orig_gy + (bounds.z2 - pos.z) * g_ppm_z
    return vector2():set(u, v)
end

-- Pre-calculate and cache global texture UV coordinates for all regional tactical map overlays
local zone_maps_initialized = false
function init_zone_map_coordinates()
    if zone_maps_initialized then return end
    local canvas = get_global_bounds()
    local g_scale_x = 4096 / math.max(1, canvas.x2 - canvas.x1)
    local g_scale_y = 8192 / math.max(1, canvas.z2 - canvas.z1)

    for _, m in ipairs(ZONE_MAP_DEFINITIONS) do
        local rect = get_level_global_rect(m.sec) or { x1 = m.gx1, z1 = m.gy1, x2 = m.gx2, z2 = m.gy2 }
        m.u1 = (rect.x1 - canvas.x1) * g_scale_x
        m.v1 = (rect.z1 - canvas.z1) * g_scale_y
        m.u2 = (rect.x2 - canvas.x1) * g_scale_x
        m.v2 = (rect.z2 - canvas.z1) * g_scale_y
    end
    zone_maps_initialized = true
end

-- ===================================================================
-- UI WINDOW CLASS
-- ===================================================================
class "UIRoadAheadTravelMap" (CUIScriptWnd)

function UIRoadAheadTravelMap:__init() super()
    self.travel_paused      = false
    self.encounter_active   = false
    self.last_log_step      = 0
    self.log_history        = {}
    self.waypoints          = {}
    self.seg_lengths        = {}
    self.cum_dist           = { 0 }
    self.total_path_len     = 1
    self.user_zoom          = 1.0
    self.last_zoom_time     = 0
    self.dest_level_name    = nil
    self.level_grects       = {}
    self.dot_gpositions     = {}

    -- Sound feedback
    self.snd_alarm  = safe_sound("detectors/contact_1")
    self.snd_evade  = safe_sound("interface/mp_reward")
    self.snd_click  = safe_sound("interface/inv_open")

    self:InitControls()
    self:InitCallbacks()
end

function UIRoadAheadTravelMap:AdjustZoom(delta)
    if self.encounter_active then return end

    local now = (time_global and time_global()) or (time_continual and time_continual()) or 0
    if self.last_zoom_time and (now - self.last_zoom_time < 20) then
        return
    end
    self.last_zoom_time = now

    local current = self.user_zoom or 1.0
    if delta > 0 then
        self.user_zoom = math.min(10.0, current * 1.15)
    elseif delta < 0 then
        self.user_zoom = math.max(0.20, current * 0.87)
    end

    pcall(function()
        local tlra_core = zzzz_the_long_road_ahead and zzzz_the_long_road_ahead.tlra
        local ratio = 0.0
        if tlra_core and tlra_core.travel_dist and tlra_core.travel_dist > 0 then
            ratio = math.min((tlra_core.current_dist or 0) / tlra_core.travel_dist, 1.0)
        end
        local cur_pos, _ = self:GetPositionAlongRoute(ratio)
        self:UpdateViewport(cur_pos, ratio)
    end)
end

function UIRoadAheadTravelMap:OnMouseScroll(iDirection)
    if iDirection > 0 then
        self:AdjustZoom(1)
    elseif iDirection < 0 then
        self:AdjustZoom(-1)
    end
end

function UIRoadAheadTravelMap:__finalize()
    GUI = nil
end

function UIRoadAheadTravelMap:InitControls()
    -- Exact standard 1024x768 virtual coordinates
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_tlra_travel_map.xml")

    -- Solid pitch-black backdrop (Covers ultrawide & multi-monitor setups)
    self.bg = xml:InitStatic("background", self)
    pcall(function()
        self.bg:SetWndRect(Frect():set(-1200, -600, 3424, 1968))
    end)

    -- 1. Fullscreen Map Viewport Frame (1024x768)
    self.map_frame          = xml:InitStatic("map_frame", self)
    self.map_frame_bg       = xml:InitStatic("map_frame:map_frame_bg", self.map_frame)

    -- Layer 1: Continuous Zone Global Base Map
    self.bg_map_canvas      = xml:InitStatic("map_frame:bg_map_canvas", self.map_frame)
    self.bg_map_canvas:SetStretchTexture(true)

    -- Layer 2: Regional Tactical Maps (PDA Multi-Zone Stitching Overlay)
    init_zone_map_coordinates()
    self.level_canvases = {}
    for _, m in ipairs(ZONE_MAP_DEFINITIONS) do
        local ok, canvas = pcall(function()
            return xml:InitStatic("map_frame:" .. m.xml_tag, self.map_frame)
        end)
